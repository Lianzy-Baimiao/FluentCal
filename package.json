{
  "name": "fluentcal",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:translations": "node scripts/check-translations.mjs",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "node scripts/tauri.mjs",
    "shots": "node scripts/shot.mjs",
    "readme-shots": "vite build && node scripts/readme-shots.mjs",
    "glyphs": "python scripts/glyph-coverage.py src/fluent/icons.ts",
    "e2e": "vite build && node scripts/e2e.mjs",
    "e2e:i18n": "vite build && node scripts/i18n-e2e.mjs",
    "a11y": "vite build && node scripts/a11y.mjs",
    "parity": "vite build && node scripts/parity.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "tyme4ts": "1.5.4",
    "uqr": "0.1.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "6.0.10",
    "axe-core": "^4.14.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
