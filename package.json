{
  "name": "fluentcal",
  "private": true,
  "version": "0.3.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:translations": "node scripts/check-translations.mjs",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "node scripts/tauri.mjs",
    "shots": "node scripts/shot.mjs",
    "readme-shots": "vite build && node scripts/readme-shots.mjs",
    "glyphs": "python scripts/glyph-coverage.py src/fluent/icons.ts",
    "e2e": "vite build && node scripts/e2e.mjs",
    "e2e:i18n": "vite build && node scripts/i18n-e2e.mjs",
    "a11y": "vite build && node scripts/a11y.mjs",
    "parity": "vite build && node scripts/parity.mjs",
    "android:dev": "vite --mode android",
    "android:build": "vue-tsc --noEmit && vite build --mode android",
    "android:sync": "npm run android:build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:e2e": "npm run android:build && node scripts/android-e2e.mjs",
    "android:sync-e2e": "npm run android:build && node scripts/android-sync-e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@tauri-apps/api": "2.12.4",
    "tyme4ts": "1.5.4",
    "uqr": "0.1.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tauri-apps/cli": "2.12.4",
    "@vitejs/plugin-vue": "6.0.10",
    "axe-core": "^4.14.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
