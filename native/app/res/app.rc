// Windows resources of fluentcal.exe: icon (id 1, used by the tray and the windows),
// manifest (common controls 6, per-monitor DPI), version info.
#pragma code_page(65001)
1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,3,9,0
PRODUCTVERSION 0,3,9,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "FluentCal"
      VALUE "FileDescription", "FluentCal 桌面日历"
      VALUE "FileVersion", "0.3.9"
      VALUE "InternalName", "fluentcal"
      VALUE "OriginalFilename", "fluentcal.exe"
      VALUE "ProductName", "FluentCal"
      VALUE "ProductVersion", "0.3.9"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
