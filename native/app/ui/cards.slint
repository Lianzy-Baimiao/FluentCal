// Settings cards, info bars, form fields (0.2's FSettingsGroup/Card/Expander/Row, FInfoBar,
// FField). Slint's named slots are experimental, so a card's control goes in @children and an
// expander's rows go in a separate SettingsExpanderItems right below its header.

import { Theme } from "theme.slint";
import { Glyph, Icon } from "icons.slint";
import { Overlay, FocusRing } from "overlay.slint";
import { Button, ButtonVariant } from "controls.slint";

// Title and description of a card or row.
component CardHead inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <bool> enabled: true;
    alignment: center;
    Text {
        text: root.title;
        color: root.enabled ? Theme.c.text-primary : Theme.c.text-disabled;
        wrap: word-wrap;
        min-height: 20px;
        vertical-alignment: center;
    }
    if root.description != "": VerticalLayout {
        padding-top: 1px;
        Text {
            text: root.description;
            font-size: 12px;
            min-height: 16px;
            color: root.enabled ? Theme.c.text-secondary : Theme.c.text-disabled;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

// A titled stack of cards; groups after the first keep 28px from the previous one.
export component SettingsGroup inherits VerticalLayout {
    in property <string> title;
    in property <bool> first: true;
    padding-top: first ? 0 : 28px;
    spacing: 4px;
    if root.title != "": HorizontalLayout {
        padding-left: 1px;
        padding-bottom: 4px;
        Text {
            text: root.title;
            font-weight: 600;
            height: 20px;
            vertical-alignment: center;
            color: Theme.c.text-primary;
        }
    }
    @children
}

// A settings card: icon, title and description, the control on the right (@children).
export component SettingsCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> description;
    in property <bool> clickable;
    in property <bool> enabled: true;
    // There is a control in @children (Slint can't tell; the gaps depend on it).
    in property <bool> has-content: true;
    callback clicked();
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.c.card-stroke;
    background: clickable && enabled ? (ta.pressed ? Theme.c.control-fill-pressed : ta.has-hover ? Theme.c.control-fill-hover : Theme.c.card-fill) : Theme.c.card-fill;
    animate background { duration: Theme.dur-fast; easing: cubic-bezier(0, 0, 0, 1); }
    min-height: 68px;
    accessible-role: groupbox;
    accessible-label: title;
    accessible-description: description;
    accessible-enabled: enabled;
    ta := TouchArea {
        enabled: root.clickable && root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 17px;
        padding-right: 17px;
        padding-top: 14px;
        padding-bottom: 14px;
        cross-axis-alignment: center;
        if root.icon != "": HorizontalLayout {
            padding-right: 20px;
            Icon { glyph: root.icon; size: 20px; color: root.enabled ? Theme.c.text-primary : Theme.c.text-disabled; }
        }
        CardHead {
            horizontal-stretch: 1;
            title: root.title;
            description: root.description;
            enabled: root.enabled;
        }
        HorizontalLayout {
            padding-left: root.has-content ? 16px : 0;
            spacing: 8px;
            alignment: end;
            cross-axis-alignment: center;
            horizontal-stretch: 0;
            @children
        }
        if root.clickable: HorizontalLayout {
            padding-left: 20px;
            Icon { glyph: Glyph.chevron-right; size: 12px; color: root.enabled ? Theme.c.text-secondary : Theme.c.text-disabled; }
        }
    }
}

// The header of a settings expander; clicking it (not its control) toggles `expanded`.
export component SettingsExpander inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> description;
    in property <bool> enabled: true;
    in property <bool> expanded;
    in property <bool> has-content: true;
    callback toggled(bool);
    property <length> r: Theme.radius-control;
    border-top-left-radius: r;
    border-top-right-radius: r;
    border-bottom-left-radius: expanded ? 0 : r;
    border-bottom-right-radius: expanded ? 0 : r;
    border-width: 1px;
    border-color: Theme.c.card-stroke;
    background: ta.has-hover ? Theme.c.control-fill-hover : Theme.c.card-fill;
    animate background { duration: Theme.dur-fast; easing: cubic-bezier(0, 0, 0, 1); }
    min-height: 68px;
    accessible-role: groupbox;
    accessible-label: title;
    accessible-expanded: expanded;
    accessible-expandable: true;
    accessible-action-expand => { root.toggle(); }
    function toggle() {
        if enabled {
            toggled(!expanded);
        }
    }
    ta := TouchArea {
        clicked => { root.toggle(); }
    }
    HorizontalLayout {
        padding-left: 17px;
        padding-right: 9px;
        padding-top: 14px;
        padding-bottom: 14px;
        cross-axis-alignment: center;
        if root.icon != "": HorizontalLayout {
            padding-right: 20px;
            Icon { glyph: root.icon; size: 20px; color: root.enabled ? Theme.c.text-primary : Theme.c.text-disabled; }
        }
        CardHead {
            horizontal-stretch: 1;
            title: root.title;
            description: root.description;
            enabled: root.enabled;
        }
        HorizontalLayout {
            padding-left: root.has-content ? 16px : 0;
            spacing: 8px;
            alignment: end;
            cross-axis-alignment: center;
            horizontal-stretch: 0;
            @children
        }
        // gap 16px, margin-left -8px
        Rectangle { width: 8px; }
        chev := Rectangle {
            width: 32px;
            height: 32px;
            border-radius: Theme.radius-control;
            background: root.enabled && cta.pressed ? Theme.c.subtle-fill-pressed : root.enabled && cta.has-hover ? Theme.c.subtle-fill-hover : transparent;
            accessible-role: button;
            accessible-label: root.title;
            accessible-expanded: root.expanded;
            Icon {
                glyph: root.expanded ? Glyph.chevron-up : Glyph.chevron-down;
                size: 12px;
                color: root.enabled ? Theme.c.text-primary : Theme.c.text-disabled;
            }
            cta := TouchArea {
                enabled: root.enabled;
                clicked => { root.toggle(); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        Overlay.keyboard = false;
                    }
                }
            }
        }
    }
}

// The rows of an expanded SettingsExpander (put it right after the header, same width).
export component SettingsExpanderItems inherits Rectangle {
    in property <bool> expanded;
    property <float> k: expanded ? 1 : 0;
    animate k { duration: Theme.dur-normal; easing: cubic-bezier(0, 0, 0, 1); }
    height: k * (rows.preferred-height + 1px);
    visible: k > 0;
    clip: true;
    Rectangle {
        y: 0;
        height: rows.preferred-height + 1px;
        border-bottom-left-radius: Theme.radius-control;
        border-bottom-right-radius: Theme.radius-control;
        border-width: 1px;
        border-color: Theme.c.card-stroke;
        background: Theme.c.card-fill-secondary;
        // no top border: cover it with the fill
        Rectangle { x: 1px; y: 0; width: parent.width - 2px; height: 1px; background: Theme.c.card-fill-secondary; }
        rows := VerticalLayout {
            y: 0;
            padding-left: 1px;
            padding-right: 1px;
            padding-bottom: 1px;
            @children
        }
    }
}

// A row inside SettingsExpanderItems. `icon-pad`: the expander has an icon (56px indent).
export component SettingsRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> icon-pad: true;
    // Not the first row: a divider above.
    in property <bool> divider;
    min-height: 52px;
    if root.divider: Rectangle { y: 0; height: 1px; background: Theme.c.card-stroke; }
    HorizontalLayout {
        padding-left: root.icon-pad ? 56px : 16px;
        padding-right: 48px;
        padding-top: root.divider ? 9px : 8px;
        padding-bottom: 8px;
        spacing: 16px;
        cross-axis-alignment: center;
        CardHead {
            horizontal-stretch: 1;
            title: root.title;
            description: root.description;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            cross-axis-alignment: center;
            horizontal-stretch: 0;
            @children
        }
    }
}

export enum Severity { info, success, warning, error }

// 0.2's FInfoBar: icon, then title, message and actions as a wrapping row (flex-wrap: column
// gap 12px, row gap 4px, actions pushed right), and the × button when `closable`. The action
// is `action-text` (one button) and/or buttons given as children (the desk's welcome bar).
export component InfoBar inherits Rectangle {
    in property <Severity> severity: Severity.info;
    in property <string> title;
    in property <string> text;
    in property <bool> closable;
    in property <string> action-text;
    in property <bool> action-accent;
    callback closed();
    callback action();
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.c.card-stroke;
    background: severity == Severity.success ? Theme.c.success-bg : severity == Severity.warning ? Theme.c.caution-bg
        : severity == Severity.error ? Theme.c.critical-bg : Theme.c.info-bg;
    accessible-role: groupbox;
    accessible-label: title;
    accessible-description: text;
    // The flex body: from after the icon to the × button (gap 16) or the border.
    property <length> left: 1px + 15px + 16px + 16px;
    property <length> right: root.closable ? root.width - 1px - 4px - 38px - 16px : root.width - 1px;
    property <length> avail: max(0, right - left);
    property <length> tw: root.title != "" ? title-m.preferred-width : 0;
    property <length> mw: msg-m.preferred-width;
    property <length> aw: acts-row.preferred-width;
    property <bool> has-act: aw > 0;
    property <bool> has-title: root.title != "";
    // Greedy line breaking: the message joins the title's line if it fits, else starts the
    // next one (shrinking to the line, so it wraps); the actions follow if they fit.
    property <bool> msg-new-line: has-title && tw + 12px + mw > avail;
    property <length> msg-x: has-title && !msg-new-line ? tw + 12px : 0;
    property <length> msg-w: min(mw, avail - msg-x);
    property <bool> msg-wraps: mw > avail - msg-x;
    property <bool> act-new-line: has-act && (msg-wraps || msg-x + msg-w + 12px + aw > avail);
    property <int> msg-line: msg-new-line ? 1 : 0;
    property <int> act-line: msg-line + (act-new-line ? 1 : 0);
    property <length> msg-h: msg.preferred-height;
    property <length> title-h: has-title ? 20px : 0;
    property <length> act-h: has-act ? acts-row.preferred-height : 0;
    property <length> line0-h: max(title-h, msg-line == 0 ? msg-h : 0, has-act && act-line == 0 ? act-h : 0);
    property <length> line1-h: max(msg-line == 1 ? msg-h : 0, has-act && act-line == 1 ? act-h : 0);
    property <length> line2-h: has-act && act-line == 2 ? act-h : 0;
    property <length> line0-y: 0;
    property <length> line1-y: line0-h + 4px;
    property <length> line2-y: line1-y + line1-h + 4px;
    property <length> content-h: act-line == 2 ? line2-y + line2-h : act-line == 1 || msg-line == 1 ? line1-y + line1-h : line0-h;
    // 13px padding above and below the content inside the border; at least 48px.
    property <length> body-y: 1px + 13px;
    height: max(48px, content-h + 2 * 13px + 2px);
    // CSS line-height 20px for the message's lines: the factor over the font's own height.
    line-m := Text { visible: false; text: "Ag"; }
    title-m := Text { visible: false; text: root.title; font-weight: 600; }
    msg-m := Text { visible: false; text: root.text; }
    Rectangle {
        x: 1px + 15px;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        Icon {
            glyph: Glyph.status-circle;
            size: 16px;
            color: root.severity == Severity.success ? Theme.c.success : root.severity == Severity.warning ? Theme.c.caution
                : root.severity == Severity.error ? Theme.c.critical : Theme.c.accent-fill;
        }
        Icon {
            glyph: root.severity == Severity.success ? Glyph.status-check : root.severity == Severity.warning ? Glyph.status-exclamation
                : root.severity == Severity.error ? Glyph.status-x : Glyph.status-info;
            size: 16px;
            color: Theme.c.text-inverse;
        }
    }
    if root.title != "": Text {
        x: root.left;
        y: root.body-y + (root.line0-h - 20px) / 2;
        width: root.tw;
        height: 20px;
        text: root.title;
        font-weight: 600;
        vertical-alignment: center;
        color: Theme.c.text-primary;
    }
    msg := Text {
        property <length> line-y: root.msg-line == 0 ? root.line0-y : root.line1-y;
        property <length> line-h: root.msg-line == 0 ? root.line0-h : root.line1-h;
        x: root.left + root.msg-x;
        y: root.body-y + line-y + (line-h - root.msg-h) / 2;
        width: root.msg-w;
        text: root.text;
        wrap: word-wrap;
        line-height-factor: 20px / line-m.preferred-height;
        vertical-alignment: center;
        color: Theme.c.text-primary;
    }
    // The buttons are measured by the inner layout (the outer one's size is set from it).
    Rectangle {
        property <length> line-y: root.act-line == 0 ? root.line0-y : root.act-line == 1 ? root.line1-y : root.line2-y;
        property <length> line-h: root.act-line == 0 ? root.line0-h : root.act-line == 1 ? root.line1-h : root.line2-h;
        x: root.right - root.aw;
        y: root.body-y + line-y + (line-h - root.act-h) / 2;
        width: root.aw;
        height: root.act-h;
        acts-row := HorizontalLayout {
            if root.action-text != "": Button {
                text: root.action-text;
                variant: root.action-accent ? ButtonVariant.accent : ButtonVariant.standard;
                clicked => { root.action(); }
            }
            @children
        }
    }
    if root.closable: Rectangle {
        x: root.width - 1px - 4px - 38px;
        y: 1px + 4px;
        width: 38px;
        height: 38px;
        border-radius: Theme.radius-control;
        background: xta.pressed ? Theme.c.subtle-fill-pressed : xta.has-hover ? Theme.c.subtle-fill-hover : transparent;
        accessible-role: button;
        accessible-label: "关闭";
        Icon { glyph: Glyph.close; size: 12px; color: xta.pressed ? Theme.c.text-secondary : Theme.c.text-primary; }
        xta := TouchArea { clicked => { root.closed(); } }
    }
}

// 0.2's FField: a label (secondary text, `label-width` wide) and the control(s).
export component Field inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 72px;
    in property <bool> top;
    spacing: 12px;
    min-height: 40px;
    cross-axis-alignment: top ? CrossAxisAlignment.start : CrossAxisAlignment.center;
    VerticalLayout {
        padding-top: root.top ? 6px : 0;
        width: root.label-width;
        Text {
            text: root.label;
            color: Theme.c.text-secondary;
            vertical-alignment: center;
            min-height: 20px;
        }
    }
    HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 8px;
        cross-axis-alignment: center;
        @children
    }
}
