// Gantt chart items (0.2's GanttChart.vue + gantt.css): bars with their handles, milestone
// diamonds, group summaries and dependency arrows.

import { Theme, BoxShadow } from "theme.slint";
import { GBar, GSummary, GLink, GanttData } from "gantt_types.slint";

// Chart-local pointer position of a TouchArea inside an item placed at (ix, iy).
export component GBarItem {
    in property <GBar> b;
    in property <length> rh: 32px;
    property <bool> sel: GanttData.selected == b.task-id;
    property <bool> hover: ta.has-hover || hl.has-hover || hr.has-hover || hp.has-hover || lk.has-hover;
    property <bool> edit: !b.rep && !GanttData.read-only;
    x: b.x + 1px;
    y: b.row * rh + 6px;
    width: max(4px, b.w - 2px);
    height: 20px;
    if !b.done: BoxShadow { width: parent.width; height: parent.height; shadow: GanttData.bar-shadow; }
    if sel: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 7px;
        border-width: 2px;
        border-color: Theme.c.focus-outer;
    }
    body := Rectangle {
        border-radius: 4px;
        background: b.rep ? b.bar.transparentize(0.2) : b.bar;
        opacity: b.done ? 0.55 : 1;
        Rectangle {
            x: 0;
            width: parent.width * b.progress / 100;
            border-radius: 4px;
            background: #00000038;
        }
        if b.rep: Rectangle { border-radius: 4px; border-width: 1px; border-color: b.rep-outline; }
        if b.inside: Text {
            x: 7px;
            width: parent.width - 14px;
            text: b.title;
            color: b.on-bar;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    if !b.inside: Text {
        x: parent.width + 14px;
        height: parent.height;
        text: b.title;
        color: b.text;
        font-size: 12px;
        font-weight: 500;
        vertical-alignment: center;
        opacity: b.done ? 0.55 : 1;
        accessible-role: none;
    }
    ta := TouchArea {
        mouse-cursor: b.rep ? pointer : grab;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                GanttData.bar-down(b, "move", root.x + self.mouse-x, root.y + self.mouse-y);
            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                GanttData.bar-up();
            } else if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                GanttData.bar-menu(b, root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        moved => { GanttData.bar-move(root.x + self.mouse-x, root.y + self.mouse-y); }
        double-clicked => { GanttData.bar-dbl(b); }
    }
    hl := TouchArea {
        x: -2px;
        width: 7px;
        enabled: edit;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { GanttData.bar-down(b, "start", root.x + self.x + self.mouse-x, root.y + self.mouse-y); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { GanttData.bar-up(); }
        }
        moved => { GanttData.bar-move(root.x + self.x + self.mouse-x, root.y + self.mouse-y); }
    }
    hr := TouchArea {
        x: parent.width - 5px;
        width: 7px;
        enabled: edit;
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { GanttData.bar-down(b, "end", root.x + self.x + self.mouse-x, root.y + self.mouse-y); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { GanttData.bar-up(); }
        }
        moved => { GanttData.bar-move(root.x + self.x + self.mouse-x, root.y + self.mouse-y); }
    }
    hp := TouchArea {
        x: parent.width * b.progress / 100 - 5px;
        y: parent.height - 5px;
        width: 10px;
        height: 10px;
        enabled: edit;
        mouse-cursor: col-resize;
        Rectangle {
            border-radius: 5px;
            background: Theme.c.solid-base;
            border-width: 2px;
            border-color: b.bar;
            opacity: (hover || sel) && edit ? 1 : 0;
            animate opacity { duration: Theme.dur-fast; }
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { GanttData.bar-down(b, "progress", root.x + self.x + self.mouse-x, root.y + self.y + self.mouse-y); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { GanttData.bar-up(); }
        }
        moved => { GanttData.bar-move(root.x + self.x + self.mouse-x, root.y + self.y + self.mouse-y); }
    }
    lk := TouchArea {
        x: parent.width + 2px;
        y: 5px;
        width: 9px;
        height: 9px;
        enabled: edit;
        mouse-cursor: crosshair;
        Rectangle {
            border-radius: 4.5px;
            background: Theme.c.solid-base;
            border-width: 1.5px;
            border-color: b.bar;
            opacity: (hover || sel) && edit ? 1 : 0;
            animate opacity { duration: Theme.dur-fast; }
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { GanttData.link-down(b, root.x + self.x + self.mouse-x, root.y + self.y + self.mouse-y); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { GanttData.link-up(root.x + self.x + self.mouse-x, root.y + self.y + self.mouse-y); }
        }
        moved => { GanttData.link-move(root.x + self.x + self.mouse-x, root.y + self.y + self.mouse-y); }
    }
}

// A milestone: the 14 px square turned 45° (a path: the software renderer has no rotation),
// centred in its day; the title to the upper right as 0.2's rotated label puts it.
export component GMilestone {
    in property <GBar> b;
    in property <length> rh: 32px;
    property <bool> sel: GanttData.selected == b.task-id;
    property <bool> edit: !GanttData.read-only;
    x: b.x + GanttData.dw / 2 - 11px;
    y: b.row * rh + rh / 2 - 11px;
    width: 22px;
    height: 22px;
    if sel: Path {
        x: -3px; y: -3px; width: 28px; height: 28px;
        viewbox-width: 28; viewbox-height: 28;
        commands: "M14 1.3 L26.7 14 L14 26.7 L1.3 14 Z";
        stroke: Theme.c.focus-outer;
        stroke-width: 2px;
        fill: transparent;
    }
    Rectangle {
        opacity: b.done ? 0.55 : 1;
        Path { y: 1px; width: 22px; height: 22px; viewbox-width: 22; viewbox-height: 22; fill: #00000024;
            commands: "M9.59 2.51 Q11 1.1 12.41 2.51 L19.49 9.59 Q20.9 11 19.49 12.41 L12.41 19.49 Q11 20.9 9.59 19.49 L2.51 12.41 Q1.1 11 2.51 9.59 Z"; }
        Path { width: 22px; height: 22px; viewbox-width: 22; viewbox-height: 22; fill: b.bar;
            commands: "M9.59 2.51 Q11 1.1 12.41 2.51 L19.49 9.59 Q20.9 11 19.49 12.41 L12.41 19.49 Q11 20.9 9.59 19.49 L2.51 12.41 Q1.1 11 2.51 9.59 Z"; }
        Text { x: 39.95px; y: -7.95px; height: 20px; text: b.title; color: b.text; font-size: 12px; font-weight: 500; vertical-alignment: center; accessible-role: none; }
    }
    TouchArea {
        mouse-cursor: grab;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { GanttData.bar-down(b, "move", root.x + self.mouse-x, root.y + self.mouse-y); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { GanttData.bar-up(); }
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { GanttData.bar-menu(b, root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y); }
        }
        moved => { GanttData.bar-move(root.x + self.mouse-x, root.y + self.mouse-y); }
        double-clicked => { GanttData.bar-dbl(b); }
    }
    lk := TouchArea {
        x: 27px; y: 6.5px; width: 9px; height: 9px;
        enabled: edit;
        mouse-cursor: crosshair;
        Rectangle { border-radius: 4.5px; background: Theme.c.solid-base; border-width: 1.5px; border-color: b.bar; opacity: (lk.has-hover || sel) && edit ? 1 : 0; }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { GanttData.link-down(b, root.x + self.x + self.mouse-x, root.y + self.y + self.mouse-y); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { GanttData.link-up(root.x + self.x + self.mouse-x, root.y + self.y + self.mouse-y); }
        }
        moved => { GanttData.link-move(root.x + self.x + self.mouse-x, root.y + self.y + self.mouse-y); }
    }
}
// A group's summary bar: done part solid, the rest at 35 %, carets under both ends.
export component GSummaryItem {
    in property <GSummary> s;
    in property <length> rh: 32px;
    x: s.x;
    y: s.row * rh + 11px;
    width: s.w;
    height: 10px;
    Rectangle { border-radius: 2px; background: s.color.transparentize(0.65); }
    Rectangle {
        x: 0;
        width: parent.width * s.progress / 100;
        border-top-left-radius: 2px;
        border-bottom-left-radius: 2px;
        border-top-right-radius: s.progress >= 100 ? 2px : 0;
        border-bottom-right-radius: s.progress >= 100 ? 2px : 0;
        background: s.color;
    }
    Path { x: 0; y: 5px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; fill: s.color; commands: "M0 0 L10 0 L5 5 L0 10 Z"; }
    Path { x: parent.width - 10px; y: 5px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; fill: s.color; commands: "M0 0 L10 0 L10 10 L5 5 Z"; }
}

// A dependency arrow (or the rubber band: `rubber`, `ok` = can link).
export component GLinkItem {
    in property <GLink> l;
    in property <bool> rubber;
    in property <bool> ok;
    property <color> c: rubber ? (ok ? Theme.c.accent-fill : Theme.c.text-tertiary) : l.late ? Theme.c.critical : Theme.c.text-tertiary;
    x: l.x;
    y: l.y;
    width: l.w;
    height: l.h;
    Path {
        viewbox-width: l.w / 1px;
        viewbox-height: l.h / 1px;
        commands: l.path;
        stroke: c;
        stroke-width: rubber ? 1.5px : 1.25px;
        fill: transparent;
    }
    if l.arrow != "": Path {
        viewbox-width: l.w / 1px;
        viewbox-height: l.h / 1px;
        commands: l.arrow;
        fill: c;
    }
}
