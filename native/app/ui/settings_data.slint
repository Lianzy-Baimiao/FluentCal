// 设置 › 提醒 and 设置 › 数据 (0.2's RemindersPage.vue with ReminderEditor.vue, DataPage.vue).

import { Theme } from "theme.slint";
import { Glyph } from "icons.slint";
import { Button, ButtonVariant, ButtonSize } from "controls.slint";
import { Toggle } from "forms.slint";
import { Select, TimePicker } from "inputs.slint";
import { SettingsGroup, SettingsCard, SettingsExpander, SettingsExpanderItems, SettingsRow, InfoBar, Severity } from "cards.slint";
import { SetState } from "settings_state.slint";

// .settings .note: 12px secondary text (a <p>: 12px margins above and below).
export component Note inherits VerticalLayout {
    in property <string> text;
    in property <length> margin: 12px;
    padding-top: margin;
    padding-bottom: margin;
    Text { text: root.text; font-size: 12px; color: Theme.c.text-secondary; wrap: word-wrap; min-height: 20px; vertical-alignment: center; }
}

// The message bar every page may show (0.2's `msg`).
export component PageMsg inherits InfoBar {
    severity: SetState.msg.severity;
    title: SetState.msg.title;
    text: SetState.msg.text;
    closable: true;
    closed => { SetState.action("msg-close"); }
}

// 新任务默认提醒 (0.2's ReminderEditor with allDay = false): one select per reminder.
component OffsetsEditor inherits VerticalLayout {
    spacing: 6px;
    for v[i] in SetState.reminders.offsets: HorizontalLayout {
        spacing: 6px;
        Select { width: 200px; value: v; options: SetState.offset-options; selected(x) => { SetState.set-offset(i, x); } }
        Button { variant: ButtonVariant.subtle; size: ButtonSize.icon; icon: Glyph.close; tip: @tr("删除提醒"); clicked => { SetState.set-offset(i, ""); } }
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Button { variant: ButtonVariant.subtle; icon: Glyph.add; text: @tr("添加提醒"); enabled: SetState.reminders.can-add; clicked => { SetState.action("add-offset"); } }
        if !SetState.reminders.enabled: Text { text: @tr("提醒已在设置中关闭"); font-size: 12px; color: Theme.c.text-secondary; vertical-alignment: center; }
    }
}

export component RemindersPage inherits VerticalLayout {
    SettingsGroup {
        title: @tr("通知");
        SettingsCard {
            icon: Glyph.alarm;
            title: @tr("任务提醒");
            description: @tr("到点弹出 Windows 通知。程序在托盘运行即可提醒。");
            Toggle { checked: SetState.reminders.enabled; toggled(v) => { SetState.set-bool("reminders.enabled", v); } }
        }
        SettingsCard {
            icon: Glyph.notification;
            title: @tr("提醒方式");
            description: @tr("提醒卡片显示在屏幕右下角，可以“完成”或“稍后提醒”，不会打断正在输入的内容");
            Select {
                width: 200px;
                value: SetState.reminders.style;
                options: [{ value: "both", label: @tr("通知 + 提醒卡片") }, { value: "popup", label: @tr("只用提醒卡片") }, { value: "toast", label: @tr("只用 Windows 通知") }];
                selected(v) => { SetState.set-str("reminders.style", v); }
            }
        }
        SettingsCard {
            icon: Glyph.clock;
            title: @tr("全天任务的提醒时间");
            description: @tr("没有设置具体时间的任务在这个时间提醒");
            TimePicker { width: 120px; value: SetState.reminders.all-day-time; changed-value(v) => { SetState.set-str("reminders.allDayTime", v); } }
        }
        SettingsCard {
            icon: Glyph.add;
            title: @tr("新任务默认提醒");
            description: @tr("新建任务时自动加上这些提醒");
            OffsetsEditor { }
        }
        SettingsCard {
            icon: Glyph.notification;
            title: @tr("发送测试通知");
            Button { text: @tr("测试"); clicked => { SetState.action("notify-test"); } }
        }
        if SetState.msg.shown: PageMsg { }
    }
    SettingsGroup {
        first: false;
        title: @tr("接下来 48 小时");
        for r in SetState.upcoming: SettingsCard { icon: Glyph.clock; title: r.title; description: r.desc; has-content: false; }
        if SetState.upcoming.length == 0: Note { text: @tr("接下来 48 小时没有提醒。"); }
    }
}

export component DataPage inherits VerticalLayout {
    property <bool> open-backups;
    spacing: 4px;
    if SetState.msg.shown: PageMsg { }
    if SetState.data.samples > 0: SettingsGroup {
        title: @tr("示例数据");
        SettingsCard {
            icon: Glyph.delete;
            title: @tr("清除示例数据");
            description: SetState.data.samples-desc;
            Button { text: @tr("清除"); clicked => { SetState.action("clear-samples"); } }
        }
    }
    SettingsGroup {
        first: SetState.data.samples == 0;
        title: @tr("导出");
        SettingsCard { icon: Glyph.save; title: @tr("完整备份（JSON）"); description: @tr("包含任务、分组、日期颜色和设置，可在其他电脑上导入"); Button { text: @tr("导出"); clicked => { SetState.action("export-json"); } } }
        SettingsCard { icon: Glyph.list; title: @tr("任务列表（CSV）"); description: @tr("用 Excel 打开查看或统计"); Button { text: @tr("导出"); clicked => { SetState.action("export-csv"); } } }
        SettingsCard { icon: Glyph.calendar; title: @tr("日历文件（ICS）"); description: @tr("导入到 Outlook、Google 日历或手机日历"); Button { text: @tr("导出"); clicked => { SetState.action("export-ics"); } } }
    }
    SettingsGroup {
        first: false;
        title: @tr("导入");
        SettingsCard { icon: Glyph.open-file; title: @tr("从备份文件导入"); description: @tr("选择之前导出的 JSON 备份"); Button { text: @tr("选择文件…"); clicked => { SetState.action("import-json"); } } }
    }
    SettingsGroup {
        first: false;
        title: @tr("自动备份");
        VerticalLayout {
                SettingsExpander {
                icon: Glyph.sync;
                title: @tr("备份文件");
                description: SetState.data.backups-desc;
                expanded: root.open-backups;
                toggled(v) => { root.open-backups = v; }
                Button { text: @tr("立即备份"); clicked => { SetState.action("backup-now"); } }
            }
                SettingsExpanderItems {
                expanded: root.open-backups;
                for b[i] in SetState.backups: SettingsRow {
                    divider: i > 0;
                    title: b.name;
                    description: b.desc;
                    Button { text: @tr("恢复"); size: ButtonSize.small; clicked => { SetState.action-arg("restore", b.name); } }
                }
                if SetState.backups.length == 0: SettingsRow { title: @tr("还没有备份"); }
            }
        }
        SettingsCard {
            icon: Glyph.folder;
            title: @tr("数据文件夹");
            description: SetState.data.dir-desc;
            Button { text: @tr("打开"); clicked => { SetState.action("open-data-dir"); } }
            Button { text: @tr("更改…"); clicked => { SetState.action("change-dir"); } }
            if SetState.data.custom: Button { text: @tr("恢复默认"); variant: ButtonVariant.subtle; clicked => { SetState.action("reset-dir"); } }
        }
        Note { text: @tr("想通过坚果云、GitHub 等在多台电脑间同步，请到“同步”页设置。"); }
        if SetState.data.missing != "": InfoBar {
            severity: Severity.warning;
            title: @tr("找不到自定义数据文件夹");
            text: SetState.data.missing + @tr(" 现在无法访问（同步盘未启动或磁盘未连接），本次使用的是本机默认文件夹。重新连接后重启程序即可。");
        }
    }
}
