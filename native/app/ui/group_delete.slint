// 删除分组: one dialog for deleting one or several groups at once. Every group is listed with a
// check box; the group the dialog was opened from (Gantt group menu, 设置 › 甘特图) is ticked.
// Both the desk and the settings window have one; Rust keeps the ticks (src/group_delete.rs).

import { Theme } from "theme.slint";
import { DialogHost, DialogBody } from "overlay.slint";
import { DialogFooter } from "dialog.slint";
import { Checkbox } from "forms.slint";

export struct GroupPick { id: string, name: string, color: color, desc: string, checked: bool }

export global GroupDelete {
    in property <[GroupPick]> items;
    in property <string> title;
    in property <bool> can-delete;
    callback toggled(string, bool);
    // "primary" (删除) or "close"
    callback answer(string);
}

// A row: the whole row ticks the box (the box is the accessible element).
component GroupPickRow inherits Rectangle {
    in property <GroupPick> pick;
    height: 36px;
    border-radius: Theme.radius-control;
    background: ta.has-hover ? Theme.c.subtle-fill-hover : transparent;
    ta := TouchArea {
        clicked => { GroupDelete.toggled(root.pick.id, !root.pick.checked); }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 10px;
            cross-axis-alignment: center;
            Checkbox {
                horizontal-stretch: 0;
                checked: root.pick.checked;
                accessible-label: root.pick.name;
                accessible-description: root.pick.desc;
                toggled(v) => { GroupDelete.toggled(root.pick.id, v); }
            }
            Rectangle { width: 10px; height: 10px; border-radius: 3px; background: root.pick.color; }
            Text {
                horizontal-stretch: 1;
                min-width: 0;
                text: root.pick.name;
                color: Theme.c.text-primary;
                overflow: elide;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                text: root.pick.desc;
                font-size: 12px;
                color: Theme.c.text-secondary;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

export component GroupDeleteDialog {
    width: 0;
    height: 0;
    public function open() { host.open(); }
    public function close() { host.close(); }
    function confirm() {
        if GroupDelete.can-delete {
            GroupDelete.answer("primary");
            host.close();
        }
    }
    host := DialogHost {
        title: GroupDelete.title;
        primary => { root.confirm(); }
        closed => { GroupDelete.answer("close"); }
        DialogBody {
            title: GroupDelete.title;
            VerticalLayout {
                spacing: 12px;
                Text {
                    text: @tr("所选分组里的任务会移到“未分组”，不会被删除。");
                    wrap: word-wrap;
                    color: Theme.c.text-primary;
                }
                Flickable {
                    // Seven and a half rows show: a cut row says the list scrolls.
                    property <length> list-h: GroupDelete.items.length * 36px;
                    preferred-height: min(270px, list-h);
                    min-height: min(36px, list-h);
                    vertical-stretch: 1;
                    content-height: list-h;
                    mouse-drag-pan-enabled: false;
                    for p[i] in GroupDelete.items: GroupPickRow {
                        y: i * 36px;
                        width: parent.width;
                        pick: p;
                    }
                }
            }
        }
        DialogFooter {
            primary-text: @tr("删除");
            primary-enabled: GroupDelete.can-delete;
            danger: true;
            primary => { root.confirm(); }
            close => { host.close(); }
        }
    }
}
