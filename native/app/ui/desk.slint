// The desk calendar (0.2's src/windows/desk): title bar, month / multi-week view with task chips
// and multi-day bars, countdown bar. View models come from Rust (src/desk/vm.rs).

import { Theme, BoxShadow } from "theme.slint";
import { Glyph, Icon } from "icons.slint";
import { GText, Button, ButtonVariant, ButtonSize, Segmented, SegOption } from "controls.slint";
import { GanttView } from "gantt.slint";
import { ChipData, TaskChip } from "chip.slint";
import { Overlay, OverlayRoot, Tip, TipLayer, Flyout, DialogHost, DialogBody, Placement, FocusRing } from "overlay.slint";
import { Menu, MenuEntry } from "menu.slint";
import { InfoBar, Severity } from "cards.slint";
import { DialogFooter } from "dialog.slint";
import { DayListPanel, YearMonthPanel, SearchPanel, SearchHitData } from "desk_overlays.slint";
import { GroupDeleteDialog } from "group_delete.slint";
import { Swatch } from "theme.slint";
export { MenuEntry, SearchHitData }
export { ChipData }

// The day grid has the keyboard (0.2: a focused .cell): the selected day's cell keeps the
// focus while the arrow keys move the selection (roving tab stop).
export global CellFocus {
    in-out property <bool> on;
    // Rust bumps it: the selected day's cell takes the focus again.
    in-out property <int> nudge;
    callback focused();
}

export struct CellData {
    date: string,
    label: string,
    lunar: string,
    // "lunar" | "month" | "term" | "festival"
    lunar-kind: string,
    // "休" | "班" | ""
    badge: string,
    rest: bool,
    today: bool,
    dim: bool,
    marked: bool,
    mark: color,
    tip: string,
    aria: string,
}


export struct WeekData {
    cells: [CellData],
    chips: [ChipData],
    // "+N" per column (0 = none) and the lane it sits in.
    more: [int],
    more-lane: [int],
    week-no: int,
}

export struct CountdownData {
    key: string,
    label: string,
    date: string,
    days: int,
    // A task's countdown (flag icon) or the next holiday (calendar icon).
    task: bool,
    tip: string,
}

// A day cell: date number, lunar text, 休/班 badge; tinted for rest days, marks and today.
component DayCell inherits Rectangle {
    in property <CellData> cell;
    in property <length> head-h;
    in property <bool> selected;
    in property <bool> drop;
    in property <bool> flash;
    callback select();
    callback quick-add();
    callback menu(length, length);
    out property <bool> head-hover: ta.has-hover && ta.mouse-y < head-h;
    property <float> fs: Theme.desk.fs;
    changed selected => {
        if selected && CellFocus.on {
            cfs.focus();
        }
    }
    init => {
        if selected && CellFocus.on {
            cfs.focus();
        }
    }
    property <int> nudge: CellFocus.nudge;
    changed nudge => {
        if selected && CellFocus.on {
            cfs.focus();
        }
    }
    // Tab reaches only the selected day (0.2: tabindex 0 / -1); other keys go to the calendar.
    cfs := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: root.selected;
        changed has-focus => {
            if self.has-focus {
                CellFocus.on = true;
                CellFocus.focused();
            }
        }
    }
    border-radius: 4px;
    background: cell.dim ? Theme.desk.cell-bg.transparentize(0.45) : Theme.desk.cell-bg;
    animate background { duration: Theme.dur-fast; easing: cubic-bezier(0, 0, 0, 1); }
    accessible-role: list-item;
    accessible-label: cell.aria;
    accessible-item-selected: selected;
    // background-image layer: today beats a day mark beats the rest-day tint.
    Rectangle {
        border-radius: 4px;
        background: cell.today ? Theme.desk.today.transparentize(0.88)
            : cell.marked ? cell.mark.transparentize(0.7)
            : cell.rest ? Theme.desk.rest-tint : transparent;
    }
    if cell.today && !drop: Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.desk.today.transparentize(0.45);
    }
    if drop: Rectangle {
        border-radius: 4px;
        border-width: 2px;
        border-color: Theme.c.accent-fill;
    }
    if flash && !drop: Rectangle {
        property <float> k: 1;
        init => { k = 0; }
        animate k { delay: Theme.reduce-motion ? 0ms : 900ms; duration: Theme.reduce-motion ? 0ms : 600ms; easing: cubic-bezier(0, 0, 0, 1); }
        border-radius: 4px;
        border-width: 2px * k;
        border-color: Theme.c.accent-fill.transparentize(1 - k);
    }
    property <int> tip-token: -1;
    changed head-hover => {
        if head-hover {
            tip-token = Tip.enter(cell.tip, root.absolute-position.x, root.absolute-position.y, root.width, root.head-h, false);
        } else {
            Tip.leave(tip-token);
        }
    }
    ta := TouchArea {
        clicked => {
            root.select();
            Overlay.keyboard = false;
            cfs.focus();
        }
        double-clicked => { root.quick-add(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.head-h;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 4px;
        alignment: start;
        cross-axis-alignment: center;
        num := Rectangle {
            property <bool> today: cell.today;
            property <color> c: cell.dim ? (cell.rest ? Theme.desk.holiday-text : Theme.c.text-secondary)
                : today ? Theme.c.text-on-accent
                : cell.rest ? Theme.desk.holiday-text : Theme.c.text-primary;
            width: max(18px * fs, n.preferred-width + (today ? 8px : 0));
            height: 18px * fs;
            border-radius: 9px;
            background: today ? Theme.desk.today : transparent;
            n := GText {
                width: 100%;
                height: 100%;
                text: cell.label;
                color: num.c;
                font-size: 13px * fs;
                font-weight: cell.dim ? 400 : 600;
                horizontal-alignment: center;
                glow: Theme.desk.glow && !num.today;
            }
        }
        if cell.lunar != "": GText {
            min-width: 0;
            text: cell.lunar;
            font-size: 11px * fs;
            overflow: elide;
            color: cell.dim ? Theme.c.text-secondary
                : cell.lunar-kind == "festival" || cell.lunar-kind == "term" ? Theme.desk.term-text
                : cell.lunar-kind == "month" ? Theme.c.text-primary
                : Theme.c.text-secondary;
        }
    }
    if cfs.has-focus && Overlay.keyboard: Rectangle {
        border-radius: 4px;
        border-width: 2px;
        border-color: Theme.c.focus-outer;
        Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            border-radius: 2px;
            border-width: 1px;
            border-color: Theme.c.focus-inner;
        }
    }
    if cell.badge != "": Rectangle {
        x: parent.width - self.width - 2px;
        y: 2px;
        width: b.preferred-width + 4px;
        height: 14px * fs;
        border-radius: 3px;
        background: cell.badge == @tr("休") ? Theme.desk.holiday-text.transparentize(0.86) : Theme.c.subtle-fill-hover;
        b := Text {
            text: cell.badge;
            font-size: 10px * fs;
            font-weight: 600;
            color: cell.badge == @tr("休") ? Theme.desk.holiday-text : Theme.c.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// One week: day cells, then the chips over them (a bar starts in its first day's cell and
// stretches over the following ones), then the "+N" buttons.
component WeekRow inherits Rectangle {
    in property <WeekData> week;
    in property <bool> show-week-no;
    in property <length> head-h;
    in property <length> chip-h;
    in property <length> lane-h;
    in property <string> selected;
    in property <string> drop-date;
    in property <string> flash-date;
    in property <string> dragging-key;
    in property <bool> read-only;
    // Quick add: the day with the inline box (0.2's ui.quickAdd), and the box's text.
    in property <string> quick-add-date;
    in-out property <string> quick-add-text;
    callback select(string);
    callback quick-add(string);
    callback quick-add-submit(string);
    callback quick-add-close();
    callback quick-add-focus();
    callback cell-menu(string, length, length);
    callback chip-toggle(ChipData);
    callback chip-open(ChipData);
    callback chip-menu(ChipData, length, length);
    callback chip-press(ChipData, length, length);
    callback chip-move(length, length);
    callback chip-release(length, length);
    callback more(string, length, length, length, length);
    property <length> gap: Theme.desk.cell-gap;
    property <float> fs: Theme.desk.fs;
    property <length> area-x: show-week-no ? 18px + gap : 0;
    property <length> area-w: root.width - area-x;
    property <length> cell-w: (area-w - 6 * gap) / 7;
    if show-week-no: GText {
        x: 0;
        y: 4px;
        width: 18px;
        height: 16px * fs;
        text: week.week-no;
        font-size: 10px * fs;
        color: Theme.c.text-tertiary;
        horizontal-alignment: center;
        vertical-alignment: top;
    }
    for c[i] in week.cells: DayCell {
        x: area-x + i * (cell-w + gap);
        y: 0;
        width: cell-w;
        height: root.height;
        cell: c;
        head-h: root.head-h;
        selected: c.date == root.selected;
        drop: c.date == root.drop-date;
        flash: c.date == root.flash-date;
        select => { root.select(c.date); }
        quick-add => { root.quick-add(c.date); }
        menu(x, y) => { root.cell-menu(c.date, x, y); }
    }
    for ch in week.chips: TaskChip {
        property <length> l: ch.cont-left ? 0 : 2px;
        property <length> r: ch.cont-right ? 0 : 2px;
        x: area-x + ch.col * (cell-w + gap) + l;
        y: head-h + ch.lane * lane-h;
        width: ch.span * cell-w + (ch.span - 1) * gap - l - r;
        height: chip-h;
        chip: ch;
        read-only: root.read-only;
        dragging: ch.key == root.dragging-key;
        toggle => { root.chip-toggle(ch); }
        open => { root.chip-open(ch); }
        menu(x, y) => { root.chip-menu(ch, x, y); }
        press(x, y) => { root.chip-press(ch, x, y); }
        drag-move(x, y) => { root.chip-move(x, y); }
        release(x, y) => { root.chip-release(x, y); }
    }
    for n[i] in week.more: Rectangle {
        x: area-x + i * (cell-w + gap) + 2px;
        y: head-h + week.more-lane[i] * lane-h;
        width: cell-w - 4px;
        height: chip-h;
        visible: n > 0;
        border-radius: 4px;
        background: mta.has-hover ? Theme.c.subtle-fill-hover : transparent;
        accessible-role: button;
        accessible-label: @tr("还有 {0} 项" , n);
        GText {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            text: "+\{n}";
            font-size: 11px * fs;
            color: mta.has-hover ? Theme.c.text-primary : Theme.c.text-secondary;
        }
        // a <button> in 0.2: Tab reaches it, Enter / Space open the list
        mfs := FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: n > 0;
            key-pressed(e) => {
                if e.text == Key.Return || e.text == " " {
                    root.more(week.cells[i].date, parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height);
                    return accept;
                }
                reject
            }
        }
        mta := TouchArea {
            enabled: n > 0;
            clicked => { root.more(week.cells[i].date, parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height); }
            double-clicked => { }
        }
        FocusRing { show: mfs.has-focus && Overlay.keyboard; radius: 4px; }
    }
    // Quick add: an inline box at the bottom of the day cell; stays open for the next entry.
    for c[i] in week.cells: Rectangle {
        x: area-x + i * (cell-w + gap) + 1px;
        y: root.height - self.height - 3px;
        width: cell-w - 2px;
        height: chip-h + 6px;
        visible: c.date == root.quick-add-date;
        if c.date == root.quick-add-date: Rectangle {
            BoxShadow { width: parent.width; height: parent.height; shadow: Theme.shadow-flyout; }
            Rectangle {
                border-radius: 4px;
                background: Theme.c.solid-base;
                border-width: 1px;
                border-color: Theme.c.control-stroke;
            }
            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.c.accent-fill;
            }
            if qa.text == "": Text {
                x: 7px;
                width: parent.width - 14px;
                height: parent.height;
                text: @tr("添加任务，回车保存");
                font-size: 12px * fs;
                color: Theme.c.text-tertiary;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            qa := TextInput {
                x: 7px;
                width: parent.width - 14px;
                height: parent.height;
                text <=> root.quick-add-text;
                font-size: 12px * fs;
                color: Theme.c.text-primary;
                selection-background-color: Theme.c.accent-fill;
                selection-foreground-color: Theme.c.text-on-accent;
                vertical-alignment: center;
                single-line: true;
                accessible-label: @tr("快速添加任务");
                init => {
                    // An inactive desktop window cannot give the input has-focus yet.
                    // Request native activation before waiting for focus changes.
                    root.quick-add-focus();
                    self.focus();
                }
                accepted => {
                    if self.text != "" { root.quick-add-submit(self.text); }
                }
                key-pressed(e) => {
                    if e.text == Key.Escape { root.quick-add-close(); return accept; }
                    reject
                }
                changed has-focus => {
                    if self.has-focus { root.quick-add-focus(); } else { root.quick-add-close(); }
                }
            }
        }
    }
}

export struct WeekdayHead { label: string, rest: bool }

// Month view and multi-week view: weekday header and week rows. `capacity` (task lanes that fit
// in a row) goes back to Rust, which lays the chips out for it. A TouchArea so that the wheel
// over any day pages (scroll events the cells don't take come up here).
component MonthView inherits TouchArea {
    in property <[WeekData]> weeks;
    in property <[WeekdayHead]> heads;
    in property <bool> show-week-no;
    in property <string> selected;
    in property <string> drop-date;
    in property <string> flash-date;
    in property <string> dragging-key;
    in property <bool> read-only;
    property <float> fs: Theme.desk.fs;
    property <length> gap: Theme.desk.cell-gap;
    property <length> head-h: round(22 * fs) * 1px;
    property <length> chip-h: round(17 * fs) * 1px;
    property <length> lane-h: chip-h + Theme.desk.line-gap;
    property <length> wd-h: 20px;
    property <length> grid-y: wd-h + gap;
    property <length> grid-h: root.height - grid-y;
    property <int> n: max(1, weeks.length);
    property <length> row-h: (grid-h - gap * (n - 1)) / n;
    out property <int> capacity: max(0, floor((row-h - head-h - 3px + Theme.desk.line-gap) / lane-h));
    // Grid geometry in window coordinates, for finding the day under the pointer (drag).
    out property <length> grid-abs-x: self.absolute-position.x + area-x;
    out property <length> grid-abs-y: self.absolute-position.y + grid-y;
    out property <length> cell-w: col-w;
    out property <length> cell-h: row-h;
    out property <length> cell-gap: gap;
    in property <string> quick-add-date;
    in-out property <string> quick-add-text;
    callback wheel(length, bool);
    callback select(string);
    callback quick-add(string);
    callback quick-add-submit(string);
    callback quick-add-close();
    callback quick-add-focus();
    callback cell-menu(string, length, length);
    callback chip-toggle(ChipData);
    callback chip-open(ChipData);
    callback chip-menu(ChipData, length, length);
    callback chip-press(ChipData, length, length);
    callback chip-move(length, length);
    callback chip-release(length, length);
    callback more(string, length, length, length, length);
    property <length> area-x: show-week-no ? 18px + gap : 0;
    property <length> col-w: (root.width - area-x - 6 * gap) / 7;
    scroll-event(e) => {
        root.wheel(e.delta-y, e.modifiers.control);
        accept
    }
    if show-week-no: GText {
        x: 0;
        y: 0;
        width: 18px;
        height: wd-h;
        text: @tr("周");
        font-size: 10px * fs;
        color: Theme.c.text-tertiary;
        horizontal-alignment: center;
    }
    for h[i] in heads: GText {
        x: area-x + i * (col-w + gap) + 6px;
        y: 0;
        width: col-w - 12px;
        height: wd-h;
        text: h.label;
        font-size: 12px * fs;
        color: h.rest ? Theme.desk.holiday-text : Theme.c.text-secondary;
    }
    accessible-role: table;
    for w[i] in weeks: WeekRow {
        x: 0;
        y: grid-y + i * (row-h + gap);
        width: root.width;
        height: row-h;
        week: w;
        show-week-no: root.show-week-no;
        head-h: root.head-h;
        chip-h: root.chip-h;
        lane-h: root.lane-h;
        selected: root.selected;
        drop-date: root.drop-date;
        flash-date: root.flash-date;
        dragging-key: root.dragging-key;
        read-only: root.read-only;
        quick-add-date: root.quick-add-date;
        quick-add-text <=> root.quick-add-text;
        select(d) => { root.select(d); }
        quick-add(d) => { root.quick-add(d); }
        quick-add-submit(t) => { root.quick-add-submit(t); }
        quick-add-close => { root.quick-add-close(); }
        quick-add-focus => { root.quick-add-focus(); }
        cell-menu(d, x, y) => { root.cell-menu(d, x, y); }
        chip-toggle(c) => { root.chip-toggle(c); }
        chip-open(c) => { root.chip-open(c); }
        chip-menu(c, x, y) => { root.chip-menu(c, x, y); }
        chip-press(c, x, y) => { root.chip-press(c, x, y); }
        chip-move(x, y) => { root.chip-move(x, y); }
        chip-release(x, y) => { root.chip-release(x, y); }
        more(d, x, y, w, h) => { root.more(d, x, y, w, h); }
    }
}

// 0.2's TitleBar: title (opens the year/month picker in the month view), paging, view switch
// and the tool buttons. Narrow windows drop the less used buttons (its container queries).
component TitleBar inherits Rectangle {
    in property <string> title;
    in property <string> view;
    in property <bool> locked;
    in property <bool> sync-enabled;
    in property <bool> sync-busy;
    in property <bool> sync-failed;
    in property <string> sync-tip;
    in property <string> today-tip;
    // The sync icon's turn, one path per frame (src/spin.rs); empty: no spinning.
    in property <[string]> spin-frames;
    callback pick-month(length, length, length, length);
    callback page(int);
    callback go-today();
    callback set-view(string);
    callback search();
    callback sync-now();
    callback toggle-lock();
    callback settings();
    callback more-menu(length, length, length, length);
    // Adjust mode: a press on the empty title bar moves the window.
    callback start-move();
    // 0.2's container queries measure the content box (padding 0 2px 0 4px).
    property <bool> wide: root.width - 6px > 520px;
    property <bool> mid: root.width - 6px > 430px;
    property <float> fs: Theme.desk.fs;
    height: 36px;
    TouchArea {
        enabled: !root.locked;
        mouse-cursor: move;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.start-move(); }
        }
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 2px;
        spacing: 8px;
        cross-axis-alignment: center;
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            cross-axis-alignment: center;
            horizontal-stretch: 0;
            title-btn := Rectangle {
                property <bool> is-button: root.view == "month";
                height: 32px;
                border-radius: 4px;
                background: is-button && tta.has-hover ? Theme.c.subtle-fill-hover : transparent;
                accessible-role: button;
                accessible-label: root.title;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    cross-axis-alignment: center;
                    GText {
                        text: root.title;
                        font-family: Theme.font-display;
                        font-size: 18px * fs;
                        font-weight: 600;
                    }
                    if title-btn.is-button: Icon {
                        glyph: Glyph.chevron-down;
                        size: 10px;
                        color: Theme.c.text-primary.transparentize(0.3);
                    }
                }
                property <int> tip-token: -1;
                tta := TouchArea {
                    enabled: title-btn.is-button;
                    changed has-hover => {
                        if self.has-hover && title-btn.is-button {
                            title-btn.tip-token = Tip.enter(@tr("选择年月"), title-btn.absolute-position.x, title-btn.absolute-position.y, title-btn.width, title-btn.height, false);
                        } else {
                            Tip.leave(title-btn.tip-token);
                        }
                    }
                    clicked => { root.pick-month(title-btn.absolute-position.x, title-btn.absolute-position.y, title-btn.width, title-btn.height); }
                }
            }
            Rectangle { width: 2px; }
            if root.view != "gantt": Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: Glyph.chevron-left;
                accessible-label: root.view == "weeks" ? @tr("上一周") : @tr("上个月");
                tip: self.accessible-label;
                tip-bottom: true;
                clicked => { root.page(-1); }
            }
            if root.view != "gantt": Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: Glyph.chevron-right;
                accessible-label: root.view == "weeks" ? @tr("下一周") : @tr("下个月");
                tip: self.accessible-label;
                tip-bottom: true;
                clicked => { root.page(1); }
            }
            if root.view != "gantt" && wide: Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.small;
                text: @tr("今天");
                tip: root.today-tip;
                clicked => { root.go-today(); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 2px;
            alignment: end;
            cross-axis-alignment: center;
            horizontal-stretch: 0;
            if mid: Segmented {
                small: true;
                value: root.view;
                options: [
                    { value: "month", label: @tr("月"), title: @tr("月视图") },
                    { value: "weeks", label: @tr("多周"), title: @tr("多周视图（滚动显示最近几周）") },
                    { value: "gantt", label: @tr("甘特"), title: @tr("甘特图") },
                ];
                selected(v) => { root.set-view(v); }
            }
            if mid: Rectangle { width: 2px; }
            Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: Glyph.search;
                accessible-label: @tr("搜索 (Ctrl+F)");
                tip: self.accessible-label;
                tip-bottom: true;
                clicked => { root.search(); }
            }
            if root.sync-enabled && wide: sync-box := Rectangle {
                property <bool> spin: root.sync-busy && root.spin-frames.length > 0;
                width: 32px;
                height: 32px;
                sync-btn := Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: sync-box.spin ? "" : root.sync-failed ? Glyph.warning : Glyph.sync;
                color-override: root.sync-failed ? Theme.c.caution : transparent;
                accessible-label: root.sync-tip;
                tip: root.sync-tip;
                tip-bottom: true;
                clicked => { root.sync-now(); }
                }
                // 0.2: the icon turns once a second while syncing
                if sync-box.spin: Path {
                    property <int> frame: mod(floor(animation-tick() / 1ms), 1000) * root.spin-frames.length / 1000;
                    x: 8px;
                    y: 8px;
                    width: 16px;
                    height: 16px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: root.spin-frames[frame];
                    fill: Theme.c.text-primary;
                    accessible-role: none;
                }
            }
            Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: root.locked ? Glyph.lock : Glyph.unlock;
                color-override: root.locked ? transparent : Theme.c.accent-text;
                accessible-label: root.locked ? @tr("解锁以调整位置和大小") : @tr("完成调整并锁定");
                tip: self.accessible-label;
                tip-bottom: true;
                clicked => { root.toggle-lock(); }
            }
            if wide: Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: Glyph.settings;
                accessible-label: @tr("设置");
                tip: @tr("设置");
                tip-bottom: true;
                clicked => { root.settings(); }
            }
            more-btn := Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: Glyph.more;
                accessible-label: @tr("更多");
                tip: @tr("更多");
                tip-bottom: true;
                clicked => { root.more-menu(more-btn.absolute-position.x, more-btn.absolute-position.y, more-btn.width, more-btn.height); }
            }
        }
    }
}

// Countdown pills under the calendar ("距 妈妈生日 还有 10 天").
component CountdownBar inherits Rectangle {
    in property <[CountdownData]> items;
    callback jump(string);
    property <float> fs: Theme.desk.fs;
    height: 22px * fs;
    clip: true;
    accessible-role: groupbox;
    accessible-label: @tr("倒数日");
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for c in root.items: pill := Rectangle {
            property <bool> hover: cta.has-hover;
            property <color> fg: hover ? Theme.c.text-primary : Theme.c.text-secondary;
            border-radius: 11px;
            background: hover ? Theme.c.subtle-fill-hover : Theme.desk.cell-bg;
            horizontal-stretch: 0;
            min-width: self.preferred-width;
            accessible-role: button;
            accessible-label: c.days == 0 ? @tr("{0} 就是今天" , c.label) : @tr("距{0}还有 {1} 天" , c.label, c.days);
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                cross-axis-alignment: center;
                Icon {
                    glyph: c.task ? Glyph.flag : Glyph.calendar-day;
                    size: 11px;
                    color: pill.fg;
                }
                GText {
                    text: c.days == 0 ? @tr("{0} 就是今天", c.label) : @tr("距{0}还有 {1} 天", c.label, c.days);
                    font-size: 12px * fs;
                    color: pill.fg;
                }
            }
            property <int> tip-token: -1;
            pfs := FocusScope {
                focus-on-click: false;
                key-pressed(e) => {
                    if e.text == Key.Return || e.text == " " {
                        root.jump(c.date);
                        return accept;
                    }
                    reject
                }
            }
            cta := TouchArea {
                changed has-hover => {
                    if self.has-hover {
                        pill.tip-token = Tip.enter(c.tip, pill.absolute-position.x, pill.absolute-position.y, pill.width, pill.height, false);
                    } else {
                        Tip.leave(pill.tip-token);
                    }
                }
                clicked => { root.jump(c.date); }
            }
            FocusRing { show: pfs.has-focus && Overlay.keyboard; radius: 11px; }
        }
    }
}

// Adjust mode outline: CSS `outline: 2px dashed` as Chromium draws it (measured in 0.2):
// dashes 3× the width, gaps about 2×, spread so each side starts and ends with a dash.
component DashedOutline {
    in property <brush> color;
    property <length> t: 2px;
    property <length> d: 3 * t;
    property <int> nx: max(2, round((root.width + 2 * t) / (d + 2 * t)));
    property <int> ny: max(2, round((root.height + 2 * t) / (d + 2 * t)));
    property <length> gx: (root.width - nx * d) / (nx - 1);
    property <length> gy: (root.height - ny * d) / (ny - 1);
    for i in nx: Rectangle { x: i * (d + gx); y: 0; width: d; height: t; background: root.color; }
    for i in nx: Rectangle { x: i * (d + gx); y: root.height - t; width: d; height: t; background: root.color; }
    for i in ny: Rectangle { x: 0; y: i * (d + gy); width: t; height: d; background: root.color; }
    for i in ny: Rectangle { x: root.width - t; y: i * (d + gy); width: t; height: d; background: root.color; }
}

// Resize grip of the adjust mode (the .grip elements of 0.2): `edge` is the winit
// ResizeDirection name.
component Grip inherits TouchArea {
    in property <string> edge;
    callback resize(string);
    pointer-event(e) => {
        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.resize(root.edge); }
    }
}

// The desk window: transparent, the calendar card inset by `pad` so its shadow has room.
export component DeskWindow inherits Window {
    in property <string> title-text;
    in property <string> view: "month";
    in property <bool> locked: true;
    in property <bool> read-only;
    in property <[WeekData]> weeks;
    in property <[WeekdayHead]> heads;
    in property <bool> show-week-no;
    in property <[CountdownData]> countdowns;
    in property <string> selected;
    in property <string> flash-date;
    in property <string> today-tip;
    in property <bool> sync-enabled;
    in property <bool> sync-busy;
    in property <bool> sync-failed;
    in property <string> sync-tip;
    in property <[string]> spin-frames;
    in property <string> quick-add-date;
    in-out property <string> quick-add-text;
    // Dragging a chip onto another day: the ghost label follows the pointer.
    in property <bool> drag-active;
    in property <string> drag-label;
    in property <length> drag-x;
    in property <length> drag-y;
    in property <string> drop-date;
    in property <string> dragging-key;
    // Transient message at the bottom, optionally with 撤销.
    in property <string> toast-text;
    in property <bool> toast-undo;
    out property <int> capacity: month.capacity;
    out property <length> grid-x: month.grid-abs-x;
    out property <length> grid-y: month.grid-abs-y;
    out property <length> cell-w: month.cell-w;
    out property <length> cell-h: month.cell-h;
    out property <length> cell-gap: month.cell-gap;
    out property <length> gantt-view-w: gantt.chart-view-w;
    out property <length> gantt-view-h: gantt.chart-view-h;
    callback capacity-changed(int);
    callback page(int);
    callback go-today();
    callback set-view(string);
    callback select(string);
    callback quick-add(string);
    callback quick-add-submit(string);
    callback quick-add-close();
    callback quick-add-focus();
    callback jump(string);
    callback chip-toggle(ChipData);
    callback chip-open(ChipData);
    callback chip-menu(ChipData, length, length);
    callback chip-press(ChipData, length, length);
    callback chip-move(length, length);
    callback chip-release(length, length);
    callback cell-menu(string, length, length);
    callback more(string, length, length, length, length);
    callback wheel(length, bool);
    callback search();
    callback sync-now();
    callback toggle-lock();
    callback settings();
    callback more-menu(length, length, length, length);
    callback pick-month(length, length, length, length);
    callback start-move();
    callback start-resize(string);
    callback toast-undo-clicked();
    callback toast-close();
    // Keys not taken by a text box: (text, ctrl, shift, alt) → handled.
    callback key(string, bool, bool, bool) -> bool;
    public function focus-root() {
        CellFocus.on = false;
        keys.focus();
    }

    // The context menus and "更多" (one Fluent menu; Rust fills it before opening).
    in property <[MenuEntry]> menu-items;
    in property <bool> menu-has-check;
    in property <bool> menu-has-icon;
    in property <bool> menu-bottom-end;
    callback menu-activated(string);
    callback menu-swatch(string, string);
    public function open-menu(x: length, y: length, w: length, h: length) {
        menu.close();
        menu.open-at(x, y, w, h);
    }
    public function close-menu() { menu.close(); }
    // "+N": the day's tasks.
    in property <string> day-list-date;
    in property <string> day-list-title;
    in property <string> day-list-lunar;
    in property <[ChipData]> day-list-chips;
    in-out property <string> day-list-text;
    callback day-list-toggle(ChipData);
    callback day-list-open(ChipData);
    callback day-list-menu(ChipData, length, length);
    callback day-list-add(string);
    callback day-list-closed();
    public function open-day-list(x: length, y: length, w: length, h: length) { day-fly.open-at(x, y, w, h); }
    public function close-day-list() { day-fly.close(); }
    // The year/month picker.
    in-out property <int> ym-year;
    in property <string> ym-cursor;
    in property <string> ym-now;
    callback ym-pick(int, int);
    public function open-ym(x: length, y: length, w: length, h: length) { ym-fly.open-at(x, y, w, h); }
    public function close-ym() { ym-fly.close(); }
    // Task search.
    in property <bool> search-open;
    in-out property <string> search-query;
    in-out property <string> search-range: "all";
    in-out property <string> search-status: "all";
    in-out property <string> search-color;
    in property <[SearchHitData]> search-hits;
    in property <string> search-empty;
    in property <[Swatch]> search-colors;
    callback search-changed();
    callback search-go(SearchHitData);
    callback search-open-task(SearchHitData);
    callback search-close();
    callback wants-keyboard();
    // A confirmation (0.2's confirm()): "primary" / "close".
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-primary: @tr("确定");
    in property <bool> confirm-danger;
    callback confirm-result(string);
    public function open-confirm() { confirm.open(); }
    public function close-confirm() { confirm.close(); }
    // 删除分组 (the GroupDelete global has the list and the ticks).
    public function open-group-delete() { group-delete.open(); }
    // Info bars under the title bar (adjust mode comes from `locked`).
    in property <bool> welcome;
    in property <string> notice;
    in property <string> save-error;
    callback lock();
    callback clear-samples();
    callback onboarded();
    callback notice-closed();
    // A menu or flyout is open (Rust then watches for presses outside the window).
    out property <bool> any-popup: menu.is-open || day-fly.is-open || ym-fly.is-open;
    callback popups-changed(bool);
    changed any-popup => { root.popups-changed(self.any-popup); }
    title: "FluentCal";
    no-frame: true;
    background: transparent;
    default-font-family: Theme.font-ui;
    default-font-size: 14px;
    min-width: 360px;
    min-height: 280px;
    property <length> pad: Theme.desk.pad;
    OverlayRoot {
    win-width: root.width;
    win-height: root.height;
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) { return accept; }
            reject
        }
        card := Rectangle {
            x: pad;
            y: pad;
            width: root.width - 2 * pad;
            height: root.height - 2 * pad;
            BoxShadow {
                width: parent.width;
                height: parent.height;
                shadow: Theme.shadow-desk;
            }
            Rectangle {
                border-radius: Theme.desk.radius;
                background: Theme.desk.bg;
                border-width: 1px;
                border-color: Theme.desk.stroke;
            }
            VerticalLayout {
                padding-top: 6px;
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 8px;
                spacing: 4px;
                tb := TitleBar {
                    title: root.title-text;
                    view: root.view;
                    locked: root.locked;
                    sync-enabled: root.sync-enabled;
                    sync-busy: root.sync-busy;
                    sync-failed: root.sync-failed;
                    sync-tip: root.sync-tip;
                    spin-frames: root.spin-frames;
                    today-tip: root.today-tip;
                    page(d) => { root.page(d); }
                    go-today => { root.go-today(); }
                    set-view(v) => { root.set-view(v); }
                    search => { root.search(); }
                    sync-now => { root.sync-now(); }
                    toggle-lock => { root.toggle-lock(); }
                    settings => { root.settings(); }
                    more-menu(x, y, w, h) => { root.more-menu(x, y, w, h); }
                    pick-month(x, y, w, h) => { root.pick-month(x, y, w, h); }
                    start-move => { root.start-move(); }
                }
                if !root.locked: InfoBar {
                    severity: Severity.info;
                    title: @tr("调整模式");
                    text: @tr("按住日历任意位置拖动来移动（可拖到其他屏幕），拖动四边或四角调整大小。");
                    Button { size: ButtonSize.small; variant: ButtonVariant.accent; text: @tr("完成"); clicked => { root.lock(); } }
                }
                if root.welcome && root.locked: InfoBar {
                    severity: Severity.info;
                    title: @tr("欢迎使用 FluentCal");
                    text: @tr("双击日期添加任务，右键任务可完成、改颜色、删除；Ctrl+Alt+D 唤出日历。现在显示的是示例任务。");
                    Button { size: ButtonSize.small; text: @tr("清除示例数据"); clicked => { root.clear-samples(); } }
                    Button { size: ButtonSize.small; variant: ButtonVariant.accent; text: @tr("知道了"); clicked => { root.onboarded(); } }
                }
                if root.notice != "": InfoBar {
                    severity: Severity.warning;
                    text: root.notice;
                    closable: true;
                    closed => { root.notice-closed(); }
                }
                if root.save-error != "": InfoBar {
                    severity: Severity.error;
                    title: @tr("无法保存");
                    text: @tr("数据暂存在内存中，正在重试。请检查磁盘空间或是否有程序占用数据文件。（") + root.save-error + "）";
                }
                body := Rectangle {
                vertical-stretch: 1;
                month := MonthView {
                    visible: root.view != "gantt";
                    weeks: root.weeks;
                    heads: root.heads;
                    show-week-no: root.show-week-no;
                    selected: root.selected;
                    flash-date: root.flash-date;
                    drop-date: root.drop-date;
                    dragging-key: root.dragging-key;
                    read-only: root.read-only;
                    quick-add-date: root.quick-add-date;
                    quick-add-text <=> root.quick-add-text;
                    select(d) => { root.select(d); }
                    quick-add(d) => { root.quick-add(d); }
                    quick-add-submit(t) => { root.quick-add-submit(t); }
                    quick-add-close => { root.quick-add-close(); }
                    quick-add-focus => { root.quick-add-focus(); }
                    chip-toggle(c) => { root.chip-toggle(c); }
                    chip-open(c) => { root.chip-open(c); }
                    chip-menu(c, x, y) => { root.chip-menu(c, x, y); }
                    chip-press(c, x, y) => { root.chip-press(c, x, y); }
                    chip-move(x, y) => { root.chip-move(x, y); }
                    chip-release(x, y) => { root.chip-release(x, y); }
                    cell-menu(d, x, y) => { root.cell-menu(d, x, y); }
                    more(d, x, y, w, h) => { root.more(d, x, y, w, h); }
                    wheel(dy, ctrl) => { root.wheel(dy, ctrl); }
                    changed capacity => { root.capacity-changed(self.capacity); }
                }
                gantt := GanttView { visible: root.view == "gantt"; }
                }
                if root.countdowns.length > 0 && root.view != "gantt": CountdownBar {
                    items: root.countdowns;
                    jump(d) => { root.jump(d); }
                }
            }
            // Adjust mode: the calendar ignores the mouse; a press anywhere below the title
            // bar moves the window (in 0.2 everything but the title bar, bars and grips).
            if !root.locked: TouchArea {
                y: body.y;
                height: parent.height - self.y;
                mouse-cursor: move;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.start-move(); }
                }
            }
            if !root.locked: DashedOutline {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                color: Theme.c.accent-fill;
            }
            if !root.locked: Grip { x: 8px; y: 0; width: parent.width - 16px; height: 8px; edge: "North"; mouse-cursor: ns-resize; resize(e) => { root.start-resize(e); } }
            if !root.locked: Grip { x: 8px; y: parent.height - 8px; width: parent.width - 16px; height: 8px; edge: "South"; mouse-cursor: ns-resize; resize(e) => { root.start-resize(e); } }
            if !root.locked: Grip { x: parent.width - 8px; y: 8px; width: 8px; height: parent.height - 16px; edge: "East"; mouse-cursor: ew-resize; resize(e) => { root.start-resize(e); } }
            if !root.locked: Grip { x: 0; y: 8px; width: 8px; height: parent.height - 16px; edge: "West"; mouse-cursor: ew-resize; resize(e) => { root.start-resize(e); } }
            if !root.locked: Grip { x: parent.width - 16px; y: 0; width: 16px; height: 16px; edge: "NorthEast"; mouse-cursor: nesw-resize; resize(e) => { root.start-resize(e); } }
            if !root.locked: Grip { x: 0; y: parent.height - 16px; width: 16px; height: 16px; edge: "SouthWest"; mouse-cursor: nesw-resize; resize(e) => { root.start-resize(e); } }
            if !root.locked: Grip { x: 0; y: 0; width: 16px; height: 16px; edge: "NorthWest"; mouse-cursor: nwse-resize; resize(e) => { root.start-resize(e); } }
            if !root.locked: Grip { x: parent.width - 16px; y: parent.height - 16px; width: 16px; height: 16px; edge: "SouthEast"; mouse-cursor: nwse-resize; resize(e) => { root.start-resize(e); } }
            if root.search-open: SearchPanel {
                property <length> w: min(360px, parent.width - 16px);
                x: parent.width - 8px - w;
                y: 44px;
                width: w;
                max-h: parent.height - 56px;
                query <=> root.search-query;
                range <=> root.search-range;
                status <=> root.search-status;
                color-key <=> root.search-color;
                hits: root.search-hits;
                empty-text: root.search-empty;
                colors: root.search-colors;
                filters-changed => { root.search-changed(); }
                go(h) => { root.search-go(h); }
                open(h) => { root.search-open-task(h); }
                close => { root.search-close(); }
                wants-keyboard => { root.wants-keyboard(); }
            }
            // Toast (the .toast of 0.2): bottom centre of the card; fades in and out while moving
            // 8px (it keeps the last text while it leaves).
            toast := Rectangle {
                property <bool> shown: root.toast-text != "";
                property <string> text-now: root.toast-text;
                property <bool> undo-now: root.toast-undo;
                property <string> last;
                property <bool> last-undo;
                property <float> k: shown ? 1 : 0;
                animate k { duration: Theme.dur-normal; easing: cubic-bezier(0, 0, 0, 1); }
                changed text-now => {
                    if shown {
                        last = text-now;
                        last-undo = undo-now;
                    }
                }
                changed undo-now => {
                    if shown {
                        last = text-now;
                        last-undo = undo-now;
                    }
                }
                visible: k > 0.001;
                opacity: k;
                x: (parent.width - self.width) / 2;
                y: parent.height - 14px - self.height + (1 - k) * 8px;
                width: tl.preferred-width;
                height: tl.preferred-height;
                BoxShadow { width: parent.width; height: parent.height; shadow: Theme.shadow-flyout; }
                Rectangle {
                    border-radius: 8px;
                    background: Theme.c.flyout-fill;
                    border-width: 1px;
                    border-color: Theme.c.card-stroke;
                }
                tl := HorizontalLayout {
                    padding-left: 15px;
                    padding-right: 5px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text {
                        text: toast.last;
                        font-size: 13px;
                        color: Theme.c.text-primary;
                    }
                    if toast.last-undo: Button {
                        size: ButtonSize.small;
                        variant: ButtonVariant.accent;
                        text: @tr("撤销");
                        clicked => { root.toast-undo-clicked(); }
                    }
                    Button {
                        size: ButtonSize.icon;
                        variant: ButtonVariant.subtle;
                        icon: Glyph.close;
                        accessible-label: @tr("关闭");
                        clicked => { root.toast-close(); }
                    }
                }
            }
        }
        // Drag ghost (the .ghost of 0.2), in window coordinates.
        if root.drag-active: Rectangle {
            x: root.drag-x + 12px;
            y: root.drag-y + 10px;
            width: min(220px, gl.preferred-width + 16px);
            height: 22px;
            BoxShadow { width: parent.width; height: parent.height; shadow: Theme.shadow-flyout; }
            Rectangle { border-radius: 4px; background: Theme.c.accent-fill; }
            gl := Text {
                x: 8px;
                width: parent.width - 16px;
                text: root.drag-label;
                font-size: 12px;
                color: Theme.c.text-on-accent;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        menu := Menu {
            items: root.menu-items;
            has-check: root.menu-has-check;
            has-icon: root.menu-has-icon;
            placement: root.menu-bottom-end ? Placement.bottom-end : Placement.bottom-start;
            activated(k) => { root.menu-activated(k); }
            swatch-picked(k, sw) => { root.menu-swatch(k, sw); }
        }
        day-fly := Flyout {
            panel-width: 280px;
            label: root.day-list-title;
            closed => { root.day-list-closed(); }
            DayListPanel {
                title: root.day-list-title;
                lunar: root.day-list-lunar;
                chips: root.day-list-chips;
                read-only: root.read-only;
                add-text <=> root.day-list-text;
                toggle(c) => { root.day-list-toggle(c); }
                open(c) => { root.day-list-open(c); }
                menu(c, x, y) => { root.day-list-menu(c, x, y); }
                add(t) => { root.day-list-add(t); }
                wants-keyboard => { root.wants-keyboard(); }
            }
        }
        ym-fly := Flyout {
            panel-width: 248px;
            label: @tr("选择年月");
            YearMonthPanel {
                year <=> root.ym-year;
                cursor: root.ym-cursor;
                now: root.ym-now;
                pick(y, m) => { ym-fly.close(); root.ym-pick(y, m); }
            }
        }
        confirm := DialogHost {
            title: root.confirm-title;
            primary => { root.confirm-result("primary"); }
            closed => { root.confirm-result("close"); }
            DialogBody {
                title: root.confirm-title;
                if root.confirm-text != "": Text { text: root.confirm-text; wrap: word-wrap; color: Theme.c.text-primary; }
            }
            DialogFooter {
                primary-text: root.confirm-primary;
                danger: root.confirm-danger;
                primary => { root.confirm-result("primary"); }
                close => { root.confirm-result("close"); }
            }
        }
        group-delete := GroupDeleteDialog { }
        TipLayer { }
    }
    }
}
