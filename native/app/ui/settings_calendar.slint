// 设置 › 日历 and 设置 › 甘特图 (0.2's CalendarPage.vue, GanttPage.vue).

import { Theme } from "theme.slint";
import { Glyph } from "icons.slint";
import { Button, ButtonVariant, ButtonSize } from "controls.slint";
import { Toggle, Checkbox } from "forms.slint";
import { Select, NumberBox, TextBox, Fluent } from "inputs.slint";
import { ColorSwatches } from "menu.slint";
import { SettingsGroup, SettingsCard } from "cards.slint";
import { SetState } from "settings_state.slint";
import { Fluent } from "inputs.slint";

// One of the 休息日 chips (0.2's .settings .chips button).
component DayChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    min-width: 36px;
    preferred-width: max(36px, t.preferred-width + 18px);
    height: 30px;
    border-radius: 15px;
    border-width: 1px;
    border-color: on ? Theme.c.accent-fill : Theme.c.control-stroke;
    background: on ? Theme.c.accent-fill : ta.has-hover ? Theme.c.control-fill-hover : Theme.c.control-fill;
    accessible-role: button;
    accessible-label: label;
    accessible-checked: on;
    accessible-action-default => { root.clicked(); }
    t := Text {
        text: root.label;
        color: root.on ? Theme.c.text-on-accent : Theme.c.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component CalendarPage inherits VerticalLayout {
    SettingsGroup {
        title: @tr("视图");
        SettingsCard {
            icon: Glyph.calendar;
            title: @tr("默认视图");
            Select {
                width: 150px;
                value: SetState.calendar.view;
                options: [{ value: "list", label: @tr("列表视图") }, { value: "month", label: @tr("月视图") }, { value: "weeks", label: @tr("多周视图") }, { value: "gantt", label: @tr("甘特图") }];
                selected(v) => { SetState.set-str("calendar.view", v); }
            }
        }
        SettingsCard {
            icon: Glyph.calendar-week;
            title: @tr("每周的第一天");
            Select {
                width: 150px;
                value: SetState.calendar.week-start;
                options: [{ value: "1", label: @tr("星期一") }, { value: "0", label: @tr("星期日") }];
                selected(v) => { SetState.set-num("calendar.weekStart", v.to-float()); }
            }
        }
        SettingsCard {
            icon: Glyph.calendar-day;
            title: @tr("月视图行数");
            description: @tr("自动：只显示本月所在的 4～6 周；固定：总是 6 周");
            Select {
                width: 150px;
                value: SetState.calendar.month-rows;
                options: [{ value: "auto", label: @tr("自动") }, { value: "six", label: @tr("固定 6 行") }];
                selected(v) => { SetState.set-str("calendar.monthRows", v); }
            }
        }
        SettingsCard {
            icon: Glyph.list;
            title: @tr("行高随任务多少调整");
            description: @tr("任务多的一周行更高，任务少的一周更矮（月视图和多周视图）");
            Toggle { checked: SetState.calendar.fit-rows; toggled(v) => { SetState.set-bool("calendar.fitRows", v); } }
        }
        SettingsCard {
            icon: Glyph.list;
            title: @tr("不定日待办栏展开方式");
            description: @tr("占用日历左侧：日历变窄；向左扩展窗口：日历大小不变，左边要有空位；浮在日历上：不改变布局，盖住左边几列");
            Select {
                width: 170px;
                value: SetState.calendar.sidebar-mode;
                options: [{ value: "inline", label: @tr("占用日历左侧") }, { value: "left", label: @tr("向左扩展窗口") }, { value: "float", label: @tr("浮在日历上") }];
                selected(v) => { SetState.set-str("calendar.sidebarMode", v); }
            }
        }
        if SetState.calendar.sidebar-mode == "float": SettingsCard {
            icon: Glyph.list;
            title: @tr("浮动待办栏的收起方式");
            description: @tr("点击栏外也收起：在待办栏以外的任何地方按下鼠标（日历、桌面、其他窗口）时自动收起，这一下点击照常生效");
            Select {
                width: 170px;
                value: SetState.calendar.sidebar-close;
                options: [{ value: "button", label: @tr("再点一次按钮") }, { value: "outside", label: @tr("点击栏外也收起") }];
                selected(v) => { SetState.set-str("calendar.sidebarClose", v); }
            }
        }
        SettingsCard {
            icon: Glyph.group;
            title: @tr("列表显示分组标签");
            description: @tr("任务名前显示分组名称和颜色；未分组不显示标签");
            Toggle { checked: SetState.calendar.list-group-labels; toggled(v) => { SetState.set-bool("calendar.listGroupLabels", v); } }
        }
        SettingsCard {
            icon: Glyph.calendar-day;
            title: @tr("多日任务显示第几天");
            description: @tr("横条的名称后显示“第5-2天（40%）”：一共 5 天，今天是第 2 天，时间过了 40%");
            Toggle { checked: SetState.calendar.bar-days; toggled(v) => { SetState.set-bool("calendar.barDays", v); } }
        }
        SettingsCard {
            icon: Glyph.completed;
            title: @tr("多日任务显示完成进度");
            description: @tr("横条的名称后显示“进度 60%”，已完成的部分颜色加深；进度在编辑任务窗口里设置");
            Toggle { checked: SetState.calendar.bar-progress; toggled(v) => { SetState.set-bool("calendar.barProgress", v); } }
        }
        SettingsCard {
            icon: Glyph.completed;
            title: @tr("多日任务显示完成日期");
            description: @tr("勾选完成后，横条的名称后显示“26.11.27完成”：勾选那天的日期；取消勾选就清除。右键任务可以修改完成日期");
            Toggle { checked: SetState.calendar.bar-done; toggled(v) => { SetState.set-bool("calendar.barDone", v); } }
        }
        SettingsCard {
            icon: Glyph.list;
            title: @tr("多周视图");
            description: @tr("显示的周数，以及其中已经过去的周数；日历每周自动向后滚动");
            Text { text: @tr("显示"); font-size: 12px; color: Theme.c.text-secondary; vertical-alignment: center; }
            NumberBox { width: 96px; value: SetState.calendar.weeks-rows; minimum: 2; maximum: 10; suffix: @tr("周"); changed-value(v) => { SetState.set-num("calendar.weeksRows", v); } }
            Text { text: @tr("已过"); font-size: 12px; color: Theme.c.text-secondary; vertical-alignment: center; }
            NumberBox { width: 96px; value: SetState.calendar.weeks-past; minimum: 0; maximum: max(0, SetState.calendar.weeks-rows - 1); suffix: @tr("周"); changed-value(v) => { SetState.set-num("calendar.weeksPast", v); } }
        }
    }
    SettingsGroup {
        first: false;
        title: @tr("显示");
        SettingsCard {
            icon: Glyph.moon;
            title: @tr("农历");
            description: @tr("在日期旁显示农历日；节日、节气始终显示");
            Toggle { checked: SetState.calendar.show-lunar; toggled(v) => { SetState.set-bool("calendar.showLunar", v); } }
        }
        SettingsCard {
            icon: Glyph.flag;
            title: @tr("法定节假日");
            description: @tr("放假显示“休”，调休上班显示“班”");
            Toggle { checked: SetState.calendar.show-holidays; toggled(v) => { SetState.set-bool("calendar.showHolidays", v); } }
        }
        SettingsCard {
            icon: Glyph.tag;
            title: @tr("周数");
            description: @tr("在每行左侧显示 ISO 周数");
            Toggle { checked: SetState.calendar.show-week-numbers; toggled(v) => { SetState.set-bool("calendar.showWeekNumbers", v); } }
        }
        SettingsCard {
            icon: Glyph.info;
            title: @tr("宜忌");
            description: @tr("鼠标停在日期上时显示农历宜忌");
            Toggle { checked: SetState.calendar.show-almanac; toggled(v) => { SetState.set-bool("calendar.showAlmanac", v); } }
        }
        SettingsCard {
            icon: Glyph.home;
            title: @tr("休息日");
            description: @tr("没有法定节假日时，这几天按休息日显示");
            HorizontalLayout {
                spacing: 4px;
                accessible-role: groupbox;
                accessible-label: @tr("休息日");
                // Monday first; rest-days is indexed 0 = Sunday
                for d[i] in [1, 2, 3, 4, 5, 6, 0]: DayChip {
                    label: [@tr("日"), @tr("一"), @tr("二"), @tr("三"), @tr("四"), @tr("五"), @tr("六")][d];
                    on: SetState.calendar.rest-days[d];
                    clicked => { SetState.set-rest-day(d, !self.on); }
                }
            }
        }
    }
    SettingsGroup {
        first: false;
        title: @tr("任务");
        SettingsCard {
            icon: Glyph.completed;
            title: @tr("显示已完成的任务");
            Toggle { checked: SetState.calendar.show-completed; toggled(v) => { SetState.set-bool("tasks.showCompleted", v); } }
        }
        SettingsCard {
            icon: Glyph.list;
            title: @tr("已完成的任务排在最后");
            Toggle { checked: SetState.calendar.completed-last; toggled(v) => { SetState.set-bool("tasks.completedLast", v); } }
        }
        SettingsCard {
            icon: Glyph.forward;
            title: @tr("未完成自动顺延");
            description: @tr("过期 30 天内未完成的单日任务，每天自动移到今天（可在任务上单独设置）");
            Toggle { checked: SetState.calendar.auto-postpone; toggled(v) => { SetState.set-bool("tasks.autoPostpone", v); } }
        }
        SettingsCard {
            icon: Glyph.color;
            title: @tr("新任务默认颜色");
            ColorSwatches { colors: SetState.task-swatches; value: SetState.calendar.default-color; allow-none: true; custom: true; custom-value: Fluent.custom-value(self.value, self.colors); custom-color: Fluent.hex-color(self.custom-value); custom-fg: Fluent.text-on(self.custom-value, Theme.c.solid-base); size: 22px; picked(v) => { SetState.set-str("tasks.defaultColor", v); } }
        }
    }
    SettingsGroup {
        first: false;
        title: @tr("倒计时显示内容");
        SettingsCard {
            icon: Glyph.flag;
            title: @tr("手工标记的倒数日");
            description: @tr("与勾选分组的任务合并显示，同一任务只出现一次");
            Toggle { checked: SetState.calendar.countdown-marked; toggled(v) => { SetState.set-bool("calendar.countdownMarked", v); } }
        }
        SettingsCard { icon: Glyph.calendar; title: @tr("法定假期"); description: ""; Toggle { checked: SetState.calendar.holiday-countdown; toggled(v) => { SetState.set-bool("calendar.holidayCountdown", v); } } }
        SettingsCard { icon: Glyph.flag; title: @tr("普通节日"); description: ""; Toggle { checked: SetState.calendar.countdown-festival; toggled(v) => { SetState.set-bool("calendar.countdownFestival", v); } } }
        SettingsCard { icon: Glyph.calendar-day; title: @tr("节气"); description: ""; Toggle { checked: SetState.calendar.countdown-term; toggled(v) => { SetState.set-bool("calendar.countdownTerm", v); } } }
        for g in SetState.groups: SettingsCard {
            title: g.name;
            description: g.desc;
            Checkbox { text: g.id == "" ? @tr("未分组") : g.name; checked: g.countdown; accessible-label: @tr("倒计时分组：{0}", g.name); toggled(v) => { SetState.action-arg("countdown-group", g.id); } }
        }
    }
}

// A group's card: name box (saved on Enter / leaving it), colour, delete.
component GroupCard inherits SettingsCard {
    in property <bool> show-card: true;
    in property <string> gid;
    in property <string> gname;
    in property <string> gcolor;
    property <string> draft: gname;
    visible: root.show-card;
    title: gname;
    if root.gid != "": TextBox {
        width: 160px;
        text <=> root.draft;
        placeholder: root.gname;
        accepted(v) => { SetState.set-group-name(root.gid, v); }
        focus-changed(f) => {
            if !f {
                SetState.set-group-name(root.gid, root.draft);
            }
        }
    }
    if root.gid != "": ColorSwatches { colors: SetState.task-swatches; value: root.gcolor; custom: true; custom-value: Fluent.custom-value(root.gcolor, SetState.task-swatches); custom-color: Fluent.hex-color(root.gcolor); custom-fg: Fluent.text-on(root.gcolor, Theme.c.solid-base); size: 18px; picked(v) => { SetState.set-group-color(root.gid, v); } }
    if root.gid != "": Button { variant: ButtonVariant.subtle; size: ButtonSize.icon; icon: Glyph.delete; tip: @tr("删除分组 ") + root.gname; clicked => { SetState.action-arg("delete-group", root.gid); } }
}

export component GanttPage inherits VerticalLayout {
    SettingsGroup {
        title: @tr("显示");
        SettingsCard {
            icon: Glyph.zoom-in;
            title: @tr("默认时间刻度");
            description: @tr("在甘特图中按住 Ctrl 滚动鼠标滚轮也可以缩放");
            Select {
                width: 120px;
                value: SetState.gantt.scale;
                options: [{ value: "day", label: @tr("按日") }, { value: "week", label: @tr("周") }, { value: "month", label: @tr("月") }];
                selected(v) => { SetState.set-str("gantt.scale", v); }
            }
        }
        SettingsCard { icon: Glyph.list; title: @tr("显示任务表"); Toggle { checked: SetState.gantt.show-table; toggled(v) => { SetState.set-bool("gantt.showTable", v); } } }
        SettingsCard {
            icon: Glyph.link;
            title: @tr("显示依赖连线");
            description: @tr("红色虚线表示后续任务开始得比前置任务结束更早");
            Toggle { checked: SetState.gantt.show-deps; toggled(v) => { SetState.set-bool("gantt.showDeps", v); } }
        }
        SettingsCard { icon: Glyph.completed; title: @tr("隐藏已完成的任务"); Toggle { checked: SetState.gantt.hide-done; toggled(v) => { SetState.set-bool("gantt.hideDone", v); } } }
        SettingsCard {
            icon: Glyph.filter;
            title: @tr("隐藏未分组的单日任务");
            description: @tr("日常待办不出现在甘特图里；里程碑和有依赖的任务不受影响");
            Toggle { checked: SetState.gantt.hide-single-day; toggled(v) => { SetState.set-bool("gantt.hideSingleDay", v); } }
        }
    }
}

export component GroupsPage inherits VerticalLayout {
    property <string> new-name;
    SettingsGroup {
        SettingsCard { icon: Glyph.group; title: @tr("未分组"); description: SetState.ungrouped-count; ColorSwatches { colors: SetState.task-swatches; value: SetState.ungrouped-color; allow-none: true; custom: true; custom-value: Fluent.custom-value(self.value, SetState.task-swatches); custom-color: Fluent.hex-color(self.custom-value); custom-fg: Fluent.text-on(self.custom-value, Theme.c.solid-base); size: 18px; picked(v) => { SetState.set-str("calendar.ungroupedColor", v); } } }
        for g in SetState.groups: GroupCard { show-card: g.id != ""; gid: g.id; gname: g.name; gcolor: g.color; description: g.desc; }
        SettingsCard {
            icon: Glyph.add;
            title: @tr("新建分组");
            TextBox {
                width: 200px;
                text <=> root.new-name;
                placeholder: @tr("分组名称");
                accepted(v) => {
                    SetState.add-group(v);
                    root.new-name = "";
                }
            }
            Button {
                text: @tr("添加");
                variant: ButtonVariant.accent;
                enabled: Fluent.trim(root.new-name) != "";
                clicked => {
                    SetState.add-group(root.new-name);
                    root.new-name = "";
                }
            }
        }
    }
}
