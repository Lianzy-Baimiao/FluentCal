// The desk's flyouts and panels (0.2's DayListFlyout, YearMonthPicker, SearchPanel). The
// window hosts them; Rust fills them (src/desk/overlays.rs).

import { Theme } from "theme.slint";
import { Glyph, Icon } from "icons.slint";
import { Button, ButtonVariant, ButtonSize } from "controls.slint";
import { Overlay, Tip, TipArea } from "overlay.slint";
import { Checkbox } from "forms.slint";
import { TextBox, Select, SelectOption, YearGrid } from "inputs.slint";
import { ColorSwatches } from "menu.slint";
import { Swatch } from "theme.slint";
import { ChipData, TaskChip } from "chip.slint";

// The day list's add box (0.2's .add input: 30px, 13px text, the accent line when focused).
component AddBox inherits Rectangle {
    in-out property <string> text;
    callback accepted(string);
    callback focused();
    property <bool> active: input.has-focus;
    height: 30px;
    border-radius: 4px;
    background: active ? Theme.c.control-fill-input-active : Theme.c.control-fill;
    border-width: 1px;
    border-color: Theme.c.control-stroke;
    accessible-role: text-input;
    accessible-label: @tr("添加任务");
    accessible-value: root.text;
    accessible-placeholder-text: @tr("添加任务，回车保存");
    forward-focus: input;
    // the bottom border: control-strong-stroke, 2px accent when focused
    Rectangle {
        y: parent.height - (root.active ? 2px : 1px);
        height: root.active ? 2px : 1px;
        background: root.active ? Theme.c.accent-fill : Theme.c.control-strong-stroke;
    }
    if root.text == "" && input.preedit-text == "": Text {
        x: 9px;
        width: parent.width - 18px;
        text: @tr("添加任务，回车保存");
        font-size: 13px;
        color: Theme.c.text-secondary;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text <=> root.text;
        font-size: 13px;
        color: Theme.c.text-primary;
        selection-background-color: Theme.c.accent-fill;
        selection-foreground-color: Theme.c.text-on-accent;
        vertical-alignment: center;
        single-line: true;
        // the box is the text field for screen readers
        accessible-role: none;
        changed has-focus => {
            if self.has-focus {
                root.focused();
            }
        }
        accepted => {
            root.accepted(self.text);
        }
        edited => {
            if self.text.character-count > 200 {
                self.text = root.text;
            }
        }
    }
}

// "+N": every task of one day (inside a Flyout with panel-width 280px).
export component DayListPanel inherits VerticalLayout {
    in property <string> title;
    in property <string> lunar;
    in property <[ChipData]> chips;
    in property <bool> read-only;
    in-out property <string> add-text;
    callback toggle(ChipData);
    callback open(ChipData);
    callback menu(ChipData, length, length);
    // One of them is pressed and dragged, out of the list onto another day (window coordinates).
    callback press(ChipData, length, length);
    callback drag-move(length, length);
    callback release(length, length);
    callback add(string);
    callback wants-keyboard();
    spacing: 8px;
    Rectangle {
        height: 20px;
        title-t := Text {
            x: 0;
            width: self.preferred-width;
            text: root.title;
            font-weight: 600;
            vertical-alignment: center;
            color: Theme.c.text-primary;
        }
        // baseline-aligned with the 14px title (align-items: baseline)
        if root.lunar != "": Text {
            x: title-t.width + 8px;
            y: 1.5px;
            text: @tr("农历") + root.lunar;
            font-size: 12px;
            vertical-alignment: center;
            color: Theme.c.text-secondary;
        }
    }
    if root.chips.length > 0: list := Flickable {
        property <length> content: root.chips.length * 26px + (root.chips.length - 1) * 2px;
        height: min(260px, content);
        content-height: content;
        // overflow-y: auto: the wheel scrolls, dragging doesn't
        mouse-drag-pan-enabled: false;
        for c[i] in root.chips: TaskChip {
            y: i * 28px;
            width: parent.width;
            height: 26px;
            chip: c;
            read-only: root.read-only;
            fs: 1;
            text-size: 13px;
            plain: true;
            toggle => { root.toggle(c); }
            open => { root.open(c); }
            menu(x, y) => { root.menu(c, x, y); }
            press(x, y) => { root.press(c, x, y); }
            drag-move(x, y) => { root.drag-move(x, y); }
            release(x, y) => { root.release(x, y); }
        }
    }
    if root.chips.length == 0: VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        Text {
            height: 20px;
            text: @tr("这一天还没有任务");
            font-size: 12px;
            vertical-alignment: center;
            color: Theme.c.text-tertiary;
        }
    }
    if !root.read-only: HorizontalLayout {
        spacing: 4px;
        cross-axis-alignment: start;
        AddBox {
            horizontal-stretch: 1;
            text <=> root.add-text;
            focused => { root.wants-keyboard(); }
            accepted(t) => { root.add(t); }
        }
        Button {
            variant: ButtonVariant.subtle;
            size: ButtonSize.icon;
            icon: Glyph.add;
            tip: @tr("添加");
            tip-layer: 1;
            accessible-label: @tr("添加");
            clicked => { root.add(root.add-text); }
        }
    }
}

// The year/month picker under the title (inside a Flyout with panel-width 248px): `year` is
// the shown year (the arrows and the wheel change it here), `cursor` / `now` "YYYY-MM". The
// year is a button: it opens the list of years, for one far away (GitHub #16).
export component YearMonthPanel inherits VerticalLayout {
    in-out property <int> year;
    in property <string> cursor;
    in property <string> now;
    in property <int> now-year;
    callback pick(int, int);
    // the years instead of the months
    property <bool> years;
    property <length> wheel-acc;
    HorizontalLayout {
        height: 32px;
        spacing: 2px;
        year-btn := Rectangle {
            property <string> label: root.years ? @tr("选择年份") : @tr("{0}年", root.year);
            horizontal-stretch: 1;
            border-radius: 4px;
            background: yta.pressed ? Theme.c.subtle-fill-pressed : yta.has-hover ? Theme.c.subtle-fill-hover : transparent;
            accessible-role: button;
            accessible-label: self.label;
            accessible-description: root.years ? @tr("返回月份") : @tr("选择年份");
            accessible-action-default => { root.years = !root.years; }
            HorizontalLayout {
                padding-left: 6px;
                spacing: 4px;
                alignment: start;
                cross-axis-alignment: center;
                Text {
                    text: year-btn.label;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: Theme.c.text-primary;
                    accessible-role: none;
                }
                Icon {
                    glyph: root.years ? Glyph.chevron-up : Glyph.chevron-down;
                    size: 10px;
                    color: Theme.c.text-secondary;
                }
            }
            yta := TouchArea { clicked => { root.years = !root.years; } }
        }
        Button {
            variant: ButtonVariant.subtle;
            size: ButtonSize.icon;
            icon: Glyph.chevron-up;
            tip: root.years ? @tr("更早的年份") : @tr("上一年");
            tip-layer: 1;
            accessible-label: self.tip;
            // (the list shows three rows of four: an arrow is a page of it)
            clicked => { root.year -= root.years ? 12 : 1; }
        }
        Button {
            variant: ButtonVariant.subtle;
            size: ButtonSize.icon;
            icon: Glyph.chevron-down;
            tip: root.years ? @tr("更晚的年份") : @tr("下一年");
            tip-layer: 1;
            accessible-label: self.tip;
            clicked => { root.year += root.years ? 12 : 1; }
        }
    }
    Rectangle { height: 6px; }
    if root.years: YearGrid {
        height: 3 * 48px + 2 * 4px;
        current: root.year;
        now: root.now-year;
        picked(y) => {
            root.year = y;
            root.years = false;
        }
    }
    // (a TouchArea: the wheel over a month comes up to it and turns the years)
    if !root.years: TouchArea {
        height: 3 * 48px + 2 * 4px;
        accessible-role: list;
        accessible-label: @tr("{0}年", root.year);
        scroll-event(e) => {
            root.wheel-acc += e.delta-y;
            if Math.abs(root.wheel-acc / 1px) >= 40 {
                root.year += root.wheel-acc > 0 ? -1 : 1;
                root.wheel-acc = 0;
            }
            accept
        }
        for m[i] in 12: Rectangle {
            property <string> key: root.year + "-" + (i < 9 ? "0" : "") + (i + 1);
            property <bool> cur: key == root.cursor;
            property <bool> is-now: key == root.now;
            x: mod(i, 4) * (parent.width - 3 * 4px) / 4 + mod(i, 4) * 4px;
            y: floor(i / 4) * 52px;
            width: (parent.width - 3 * 4px) / 4;
            height: 48px;
            border-radius: 4px;
            background: cur ? Theme.c.accent-fill : mta.has-hover ? Theme.c.subtle-fill-hover : transparent;
            accessible-role: list-item;
            accessible-label: @tr("{0}月", i + 1);
            accessible-item-selected: cur;
            accessible-item-selectable: true;
            Text {
                text: @tr("{0}月", i + 1);
                font-weight: is-now ? 600 : 400;
                color: cur ? Theme.c.text-on-accent : is-now ? Theme.c.accent-text : Theme.c.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            mta := TouchArea { clicked => { root.pick(root.year, i + 1); } }
        }
    }
}

export struct SearchHitData { task-id: string, date: string, title: string, done: bool, color: color, when: string }

// Task search (0.2's SearchPanel): a panel at the card's top right, not light-dismissed.
// The window positions it; `filters-changed` asks Rust for `hits` again.
export component SearchPanel inherits Rectangle {
    in-out property <string> query;
    in-out property <string> range: "all";
    in-out property <string> status: "all";
    in-out property <string> color-key;
    in property <[SearchHitData]> hits;
    in property <string> empty-text;
    in property <[Swatch]> colors;
    // The panel's room (0.2: max-height calc(100% - 56px) of the card).
    in property <length> max-h;
    callback filters-changed();
    callback go(SearchHitData);
    callback open(SearchHitData);
    callback close();
    callback wants-keyboard();
    public function focus-box() { box.focus-input(); }
    property <length> fixed: 1px + 12px + 33px + 8px + filters.preferred-height + 8px + 12px + 1px;
    property <length> list-h: root.hits.length > 0 ? min(root.hits.length * 32px, max(0, root.max-h - fixed)) : 28px;
    height: fixed + list-h;
    border-radius: 8px;
    background: Theme.flyout-solid;
    border-width: 1px;
    border-color: Theme.c.card-stroke;
    accessible-role: groupbox;
    accessible-label: @tr("搜索任务");
    // presses on the panel don't reach the calendar below
    TouchArea { }
    VerticalLayout {
        padding: 13px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 4px;
            box := TextBox {
                horizontal-stretch: 1;
                text <=> root.query;
                icon: Glyph.search;
                placeholder: @tr("搜索任务、备注或分组");
                clearable: true;
                autofocus: true;
                edited => { root.filters-changed(); }
                focus-changed(f) => { if f { root.wants-keyboard(); } }
                escape => { root.close(); }
                accepted => { if root.hits.length > 0 { root.go(root.hits[0]); } }
            }
            Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: Glyph.close;
                tip: @tr("关闭 (Esc)");
                accessible-label: @tr("关闭 (Esc)");
                clicked => { root.close(); }
            }
        }
        filters := FlexboxLayout {
            spacing-horizontal: 6px;
            spacing-vertical: 6px;
            cross-axis-alignment: center;
            Select {
                width: 120px;
                value: root.range;
                options: [
                    { value: "all", label: @tr("全部时间") },
                    { value: "1m", label: @tr("前后一月") },
                    { value: "3m", label: @tr("前后三月") },
                    { value: "1y", label: @tr("前后一年") },
                ];
                selected(v) => { root.range = v; root.filters-changed(); }
            }
            Select {
                width: 120px;
                value: root.status;
                options: [
                    { value: "all", label: @tr("全部") },
                    { value: "undone", label: @tr("未完成") },
                    { value: "done", label: @tr("已完成") },
                ];
                selected(v) => { root.status = v; root.filters-changed(); }
            }
            // one flex item at its max-content width (it wraps under the selects as a whole)
            ColorSwatches {
                width: (root.colors.length + 1) * 18px + root.colors.length * 6px;
                colors: root.colors;
                value: root.color-key;
                allow-none: true;
                size: 18px;
                picked(k) => { root.color-key = k; root.filters-changed(); }
            }
        }
        if root.hits.length == 0: VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            padding-left: 2px;
            padding-right: 2px;
            Text {
                height: 20px;
                text: root.empty-text;
                font-size: 12px;
                vertical-alignment: center;
                color: Theme.c.text-tertiary;
            }
        }
        if root.hits.length > 0: Flickable {
            height: root.list-h;
            content-height: root.hits.length * 32px;
            mouse-drag-pan-enabled: false;
            accessible-role: list;
            accessible-label: @tr("搜索结果");
            for h[i] in root.hits: Rectangle {
                y: i * 32px;
                width: parent.width;
                height: 32px;
                border-radius: 4px;
                background: hta.has-hover ? Theme.c.subtle-fill-hover : transparent;
                accessible-role: list-item;
                accessible-label: h.title;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: h.color; }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0;
                        height: 20px;
                        t := Text {
                            width: parent.width;
                            text: h.title;
                            overflow: elide;
                            vertical-alignment: center;
                            color: h.done ? Theme.c.text-secondary : Theme.c.text-primary;
                        }
                        if h.done: Rectangle {
                            x: 0;
                            y: round((parent.height / 2 + 1px) / 1phx) * 1phx;
                            width: min(parent.width, t.preferred-width);
                            height: 1px;
                            background: Theme.c.text-secondary;
                        }
                    }
                    Text {
                        text: h.when;
                        font-size: 12px;
                        vertical-alignment: center;
                        color: Theme.c.text-secondary;
                    }
                }
                hta := TouchArea {
                    clicked => { root.go(h); }
                    double-clicked => { root.open(h); }
                }
            }
        }
    }
}

export struct ChangeRowData { id: int, text: string, when: string, undone: bool }

// 按分组筛选 (GitHub #14): a group (or 未分组, id "") with its colour, how many tasks it has, and
// whether the calendar shows it.
export struct FilterRowData { id: string, name: string, color: color, dot: bool, checked: bool, count: string }
// A choice: the whole row ticks the box (the box is the accessible element).
component FilterRow inherits Rectangle {
    in property <string> name;
    in property <color> dot;
    in property <bool> has-dot;
    in property <bool> checked;
    in property <string> count;
    callback toggled(bool);
    height: 32px;
    border-radius: Theme.radius-control;
    background: ta.has-hover ? Theme.c.subtle-fill-hover : transparent;
    ta := TouchArea {
        clicked => { root.toggled(!root.checked); }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            cross-axis-alignment: center;
            Checkbox {
                horizontal-stretch: 0;
                size: 18px;
                checked: root.checked;
                accessible-label: root.name;
                accessible-description: root.count;
                toggled(v) => { root.toggled(v); }
            }
            if root.has-dot: Rectangle { width: 10px; height: 10px; border-radius: 3px; background: root.dot; }
            Text {
                horizontal-stretch: 1;
                min-width: 0;
                text: root.name;
                color: Theme.c.text-primary;
                overflow: elide;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                text: root.count;
                font-size: 12px;
                color: Theme.c.text-secondary;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

// The list under the title bar's filter button: 全部 (no filter), then 未分组 and the groups,
// any number of which can be ticked. It stays open while they are.
export component GroupFilterPanel inherits VerticalLayout {
    in property <bool> countdown-mode;
    in property <bool> marked;
    in property <bool> holiday;
    in property <bool> festival;
    in property <bool> term;
    callback source(string, bool);
    in property <[FilterRowData]> rows;
    in property <string> all-count;
    // nothing is filtered
    in property <bool> all;
    // said under the list while there are no groups
    in property <string> hint;
    callback toggle(string, bool);
    callback clear();
    callback manage();
    property <length> list-h: root.rows.length * 32px;
    padding: 5px;
    spacing: 4px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        height: 28px;
        Text {
            text: root.countdown-mode ? @tr("倒计时显示内容") : @tr("按分组筛选");
            font-weight: 600;
            vertical-alignment: center;
            color: Theme.c.text-primary;
        }
    }
    if !root.countdown-mode: FilterRow {
        name: @tr("全部");
        checked: root.all;
        count: root.all-count;
        toggled(v) => { root.clear(); }
    }
    if root.countdown-mode: FilterRow { name: @tr("手工标记的倒数日"); checked: root.marked; toggled(v) => { root.source("countdownMarked", v); } }
    if root.countdown-mode: FilterRow { name: @tr("法定假期"); checked: root.holiday; toggled(v) => { root.source("holidayCountdown", v); } }
    if root.countdown-mode: FilterRow { name: @tr("普通节日"); checked: root.festival; toggled(v) => { root.source("countdownFestival", v); } }
    if root.countdown-mode: FilterRow { name: @tr("节气"); checked: root.term; toggled(v) => { root.source("countdownTerm", v); } }
    Rectangle { visible: !root.countdown-mode; height: 1px; background: Theme.c.divider; }
    Flickable {
        // eight and a half show: a cut row says the list scrolls (less in a low window)
        height: min(root.list-h, 272px, max(64px, Overlay.win-h - 200px));
        content-height: root.list-h;
        mouse-drag-pan-enabled: false;
        for r[i] in root.rows: FilterRow {
            visible: true;
            y: i * 32px;
            width: parent.width;
            name: r.name;
            dot: r.color;
            has-dot: r.dot;
            checked: r.checked;
            count: r.count;
            toggled(v) => { root.toggle(r.id, v); }
        }
    }
    if root.hint != "": HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 4px;
        Text {
            text: root.hint;
            font-size: 12px;
            wrap: word-wrap;
            color: Theme.c.text-tertiary;
        }
    }
    Rectangle { visible: !root.countdown-mode; height: 1px; background: Theme.c.divider; }
    if !root.countdown-mode: HorizontalLayout {
        alignment: start;
        Button {
            variant: ButtonVariant.subtle;
            size: ButtonSize.small;
            icon: Glyph.settings;
            text: @tr("管理分组…");
            clicked => { root.manage(); }
        }
    }
}

// 最近更改 (GitHub #11): the last changes, newest first, each with 撤销 (恢复 once it is taken
// back). A panel at the card's top right, like the search panel.
export component ChangesPanel inherits Rectangle {
    in property <[ChangeRowData]> rows;
    in property <length> max-h;
    callback revert(int);
    callback clear();
    callback close();
    property <length> fixed: 1px + 12px + 32px + 8px + 12px + 1px;
    property <length> list-h: root.rows.length > 0 ? min(root.rows.length * 36px, max(36px, root.max-h - fixed)) : 28px;
    height: fixed + list-h;
    border-radius: 8px;
    background: Theme.flyout-solid;
    border-width: 1px;
    border-color: Theme.c.card-stroke;
    accessible-role: groupbox;
    accessible-label: @tr("最近更改");
    // presses on the panel don't reach the calendar below
    TouchArea { }
    VerticalLayout {
        padding: 13px;
        spacing: 8px;
        HorizontalLayout {
            height: 32px;
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                text: @tr("最近更改");
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                color: Theme.c.text-primary;
            }
            if root.rows.length > 0: Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.small;
                text: @tr("清空记录");
                clicked => { root.clear(); }
            }
            Button {
                variant: ButtonVariant.subtle;
                size: ButtonSize.icon;
                icon: Glyph.close;
                tip: @tr("关闭");
                accessible-label: @tr("关闭");
                clicked => { root.close(); }
            }
        }
        if root.rows.length == 0: Text {
            height: 28px;
            text: @tr("还没有更改。添加、修改、删除任务后会记在这里，可以随时撤销。");
            font-size: 12px;
            vertical-alignment: center;
            wrap: word-wrap;
            color: Theme.c.text-tertiary;
        }
        if root.rows.length > 0: Flickable {
            height: root.list-h;
            content-height: root.rows.length * 36px;
            mouse-drag-pan-enabled: false;
            accessible-role: list;
            accessible-label: @tr("最近更改");
            for r[i] in root.rows: Rectangle {
                y: i * 36px;
                width: parent.width;
                height: 36px;
                accessible-role: list-item;
                accessible-label: r.text;
                accessible-description: r.when;
                HorizontalLayout {
                    padding-left: 4px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0;
                        height: 20px;
                        t := Text {
                            width: parent.width;
                            text: r.text;
                            overflow: elide;
                            vertical-alignment: center;
                            color: r.undone ? Theme.c.text-tertiary : Theme.c.text-primary;
                        }
                        if r.undone: Rectangle {
                            x: 0;
                            y: round((parent.height / 2 + 1px) / 1phx) * 1phx;
                            width: min(parent.width, t.preferred-width);
                            height: 1px;
                            background: Theme.c.text-tertiary;
                        }
                    }
                    Text {
                        text: r.when;
                        font-size: 12px;
                        vertical-alignment: center;
                        color: Theme.c.text-secondary;
                    }
                    Button {
                        variant: ButtonVariant.subtle;
                        size: ButtonSize.small;
                        text: r.undone ? @tr("恢复") : @tr("撤销");
                        accessible-label: (r.undone ? @tr("恢复") : @tr("撤销")) + " " + r.text;
                        clicked => { root.revert(r.id); }
                    }
                }
            }
        }
    }
}
